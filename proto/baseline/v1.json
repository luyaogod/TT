0,2,2,3],"span":[18,16,17]},{"path":[4,0,2,3,5],"span":[20,2,8]},{"path":[4,0,2,3],"span":[20,2,17],"leadingComments":" env 出错的环节名（若与本错误相关）。\n"},{"path":[4,0,2,3,1],"span":[20,9,12]},{"path":[4,0,2,3,3],"span":[20,15,16]},{"path":[4,1],"span":[26,0,35,1],"leadingComments":" Capabilities 本 Host 实例的能力清单。\n\n 插件**必须**以此为准，不得假定某个方法存在：未列出的方法即未交付。\n"},{"path":[4,1,1],"span":[26,8,20]},{"path":[4,1,2,0,5],"span":[28,2,8]},{"path":[4,1,2,0],"span":[28,2,30],"leadingComments":" host_api_version 语义化版本（MAJOR.MINOR.PATCH）。插件清单的 hostApi 范围按它判。\n"},{"path":[4,1,2,0,1],"span":[28,9,25]},{"path":[4,1,2,0,3],"span":[28,28,29]},{"path":[4,1,2,1,4],"span":[30,2,10]},{"path":[4,1,2,1],"span":[30,2,32],"leadingComments":" features 已启用的能力开关，见 Feature 枚举。\n"},{"path":[4,1,2,1,6],"span":[30,11,18]},{"path":[4,1,2,1,1],"span":[30,19,27]},{"path":[4,1,2,1,3],"span":[30,30,31]},{"path":[4,1,2,2,4],"span":[32,2,10]},{"path":[4,1,2,2],"span":[32,2,42],"leadingComments":" services 已挂载的服务与方法全集。\n"},{"path":[4,1,2,2,6],"span":[32,11,28]},{"path":[4,1,2,2,1],"span":[32,29,37]},{"path":[4,1,2,2,3],"span":[32,40,41]},{"path":[4,1,2,3,5],"span":[34,2,8]},{"path":[4,1,2,3],"span":[34,2,24],"leadingComments":" tt_version tt 自身的版本号（信息性，不参与兼容判断）。\n"},{"path":[4,1,2,3,1],"span":[34,9,19]},{"path":[4,1,2,3,3],"span":[34,22,23]},{"path":[4,2],"span":[38,0,41,1],"leadingComments":" ServiceCapability 一个已挂载服务及方法。\n"},{"path":[4,2,1],"span":[38,8,25]},{"path":[4,2,2,0,5],"span":[39,2,8]},{"path":[4,2,2,0],"span":[39,2,18]},{"path":[4,2,2,0,1],"span":[39,9,13]},{"path":[4,2,2,0,3],"span":[39,16,17]},{"path":[4,2,2,1,4],"span":[40,2,10]},{"path":[4,2,2,1],"span":[40,2,30]},{"path":[4,2,2,1,5],"span":[40,11,17]},{"path":[4,2,2,1,1],"span":[40,18,25]},{"path":[4,2,2,1,3],"span":[40,28,29]},{"path":[5,0],"span":[46,0,56,1],"leadingComments":" Feature* 是 Capabilities.features 的取值。\n\n 只声明**真的能用**的能力：某个能力没实现时，对应方法也不注册（而不是注册了却报错）。\n"},{"path":[5,0,1],"span":[46,5,12]},{"path":[5,0,2,0,1],"span":[47,2,21]},{"path":[5,0,2