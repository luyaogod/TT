   #應用 a69 樣板自動產生(Version:1)
   #單身多語言複製更新段  #1.0版無此功能

   #將key修正為調整後
   UPDATE mdl_${mdl_lang_tbl}
      #更新key欄位
      SET ${mdl_field_fk01} = ${master_var_pk01}
          #master_keys - Start -
          , ${mdl_field_fk${key}} = ${master_var_pk${key}}
          #keys -  End  -

   #add-point:單身修改前 name="detail_reproduce.body.lang${lang}.b_update"
   {<point name="detail_reproduce.body.lang${lang}.b_update"/>}
   #end add-point

   #避免因殘留的新key資料影響寫入, 先進行刪除動作
   DELETE FROM ${mdl_lang_tbl}
    WHERE ${mdl_append_wc} ${mdl_field_fk01} = ${master_var_pk01}
      #master_keys - Start -
      AND ${mdl_field_fk${key}} = ${master_var_pk${key}}
      #keys -  End  -

   #將資料塞回原table
   INSERT INTO ${mdl_lang_tbl} SELECT * FROM mdl_${mdl_lang_tbl}

   IF SQLCA.sqlcode THEN
      #add-point:錯誤時處理 name="detail_reproduce.body.lang${lang}.rollback"
      {<point name="detail_reproduce.body.lang${lang}.rollback"/>}
      #end add-point

      ${mdl_mark}CALL s_transaction_end('N','0')
      INITIALIZE g_errparam TO NULL
      LET g_errparam.extend = "reproduce"
      LET g_errparam.code   = SQLCA.sqlcode
      LET g_errparam.popup  = TRUE
      CALL cl_err()

      RETURN
   END IF

   #add-point:單身複製中1 name="detail_reproduce.lang${lang}.table1.m_insert"
   {<point name="detail_reproduce.lang${lang}.table1.m_insert"/>}
   #end add-point

