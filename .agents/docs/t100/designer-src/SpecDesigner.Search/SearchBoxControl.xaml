<UserControl
	x:Class="SpecDesigner.Search.SearchBoxControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:Custom="http://schemas.microsoft.com/wpf/2008/toolkit"
	xmlns:s="clr-namespace:System;assembly=mscorlib"
	xmlns:l="clr-namespace:SpecDesigner.Search"
	xmlns:h="clr-namespace:SpecDesigner.Search.Helper"
	xmlns:lc="clr-namespace:SpecDesigner.Controls.Controls;assembly=SpecDesigner.Controls"
	x:Name="searchBoxControl">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<h:MatchStringConverter
				x:Key="matchStringConverter" />
			<h:MatchColorConverter
				x:Key="matchColorConverter" />
			<s:Boolean
				x:Key="TrueValue">True</s:Boolean>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Background="#FFFFFFFF">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<StackPanel
			Grid.Row="0">
			<TextBlock
				Text="{StaticResource menu_FindTarget}" />
			<lc:AutoFilteredComboBox
				x:Name="SearchCB"
				IsCaseSensitive="False"
				IsEditable="True"
				StaysOpenOnEdit="False"
				IsTextSearchCaseSensitive="True"
				IsTextSearchEnabled="True"
				ItemsSource="{Binding SearchHistory}">
				<UIElement.InputBindings>
					<KeyBinding
						Command="l:SearchCommands.SearchCommnad"
						Key="Enter" />
				</UIElement.InputBindings>
			</lc:AutoFilteredComboBox>
			<TextBlock
				Text="{StaticResource menu_FindRange}" />
			<ComboBox
				x:Name="SearchTargetCB"
				IsEditable="True"
				SelectedIndex="0">
				<ComboBoxItem
					Tag="Current Document"
					Content="{StaticResource Search_CurrentDocument}" />
				<ComboBoxItem
					Tag="All Open Documents"
					Content="{StaticResource Search_AllOpenDocument}" />
			</ComboBox>
			<GroupBox
				Header="Options"
				Margin="0 4 0 4">
				<StackPanel>
					<CheckBox
						Content="{StaticResource Search_MatchCase}"
						IsChecked="{Binding IsMatchCase, ElementName=searchBoxControl, Mode=TwoWay}" />
					<CheckBox
						Content="{StaticResource Search_Reg}"
						IsChecked="{Binding IsRegExMode, ElementName=searchBoxControl, Mode=TwoWay}" />
					<CheckBox
						Content="{StaticResource Search_Spec}"
						IsChecked="{Binding IsSearchSpec, ElementName=searchBoxControl, Mode=TwoWay}" />
				</StackPanel>
			</GroupBox>
		</StackPanel>
		<UniformGrid
			HorizontalAlignment="Right"
			Grid.Row="1"
			Columns="2">
			<Button
				Content="{StaticResource Search_BeginSearch}"
				Grid.Column="1"
				Margin="4,0"
				MinWidth="70"
				Command="l:SearchCommands.SearchCommnad" />
			<Button
				x:Name="PreviousBtn"
				Content="{StaticResource Search_Previous}"
				Margin="4,0"
				MinWidth="70"
				Command="l:SearchCommands.PreviousCommnad" />
			<Label />
			<Button
				x:Name="NextBtn"
				Content="{StaticResource Search_Next}"
				Margin="4,0"
				MinWidth="70"
				Command="l:SearchCommands.NextCommnad" />
		</UniformGrid>
		<DataGrid
			x:Name="dataGrid"
			Grid.Row="2"
			AutoGenerateColumns="False"
			IsReadOnly="True"
			SelectionMode="Single"
			SelectedItem="{Binding CurrentSearchResult}"
			Sorting="dataGrid_Sorting"
			MouseDoubleClick="DataGrid_MouseDoubleClick">
			<DataGrid.Columns>
				<DataGridTemplateColumn
					Header="{StaticResource Search_ProgramName}"
					SortMemberPath="Program"
					CanUserSort="True">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock>
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type TextBlock}">
										<Setter
											Property="Text"
											Value="{Binding ProgramKey.Program}" />
										<Style.Triggers>
											<DataTrigger
												Value="CodeDiff"
												Binding="{Binding ProgramKey.Memo}">
												<Setter
													Property="Text">
													<Setter.Value>
														<MultiBinding
															StringFormat="{}{0}_Diff">
															<Binding
																Path="ProgramKey.Program" />
														</MultiBinding>
													</Setter.Value>
												</Setter>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
							</TextBlock>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Header="{StaticResource Search_Source}"
					SortMemberPath="SourceType"
					CanUserSort="True">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Image
								Width="16">
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type Image}">
										<Style.Triggers>
											<DataTrigger
												Value="FORM"
												Binding="{Binding SourceType}">
												<Setter
													Property="Source"
													Value="pack://application:,,,/T100Designer;component/Images/document_4fd.png" />
											</DataTrigger>
											<DataTrigger
												Value="CODE"
												Binding="{Binding SourceType}">
												<Setter
													Property="Source"
													Value="pack://application:,,,/T100Designer;component/Images/document_4gl.png" />
											</DataTrigger>
											<DataTrigger
												Value="CODEDIFF"
												Binding="{Binding SourceType}">
												<Setter
													Property="Source"
													Value="pack://application:,,,/T100Designer;component/Images/document_4gl.png" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
							</Image>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Header="{StaticResource Search_Match}"
					Width="Auto"
					SortMemberPath="Match"
					CanUserSort="True">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock
								Text="{Binding Converter='{StaticResource matchStringConverter}'}">
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type TextBlock}">
										<Style.Triggers>
											<DataTrigger
												Value="{StaticResource TrueValue}"
												Binding="{Binding Converter='{StaticResource matchColorConverter}'}">
												<Setter
													Property="Background"
													Value="#FF90EE90" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
							</TextBlock>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
		<TextBlock
			Grid.Row="3"
			Margin="5 0 5 0"
			Text="{Binding Count, Mode=OneWay}" />
	</Grid>
</UserControl>
