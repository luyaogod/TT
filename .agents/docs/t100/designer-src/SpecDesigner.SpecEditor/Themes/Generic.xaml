<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:SpecDesigner.SpecEditor.Views"
	xmlns:ctrls="clr-namespace:SpecDesigner.SpecEditor.Controls"
	xmlns:ch="clr-namespace:SpecDesigner.Controls.Controls;assembly=SpecDesigner.Controls">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="pack://application:,,,/SpecDesigner.Controls;component/Styles/Controls.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<BitmapImage
		x:Key="ModifyImageSource"
		UriSource="pack://application:,,,/SpecDesigner.SpecEditor;component/Images/alt_edit.png" />
	<SolidColorBrush
		x:Key="ListBorder"
		Color="#FF7F9DB9" />
	<SolidColorBrush
		x:Key="RequiredBorderBackground"
		Color="#FFFFFBCD" />
</ResourceDictionary>
