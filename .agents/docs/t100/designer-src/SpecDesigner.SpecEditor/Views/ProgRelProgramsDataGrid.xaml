<UserControl
	x:Class="SpecDesigner.SpecEditor.Views.ProgRelProgramsDataGrid"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:views="clr-namespace:SpecDesigner.SpecEditor.Views"
	xmlns:helpers="clr-namespace:SpecDesigner.SpecEditor.Helpers"
	xmlns:ch="clr-namespace:SpecDesigner.Controls.Controls;assembly=SpecDesigner.Controls"
	xmlns:l="clr-namespace:SpecDesigner.SpecEditor"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	x:Name="progRelPrograms">
	<DockPanel>
		<FrameworkElement.Style>
			<Style
				TargetType="{x:Type DockPanel}">
				<Setter
					Property="IsEnabled"
					Value="True" />
				<Style.Triggers>
					<DataTrigger
						Value="Y"
						Binding="{Binding ProgRelNode.CiteStd, ElementName=progRelPrograms}">
						<Setter
							Property="IsEnabled"
							Value="False" />
					</DataTrigger>
					<DataTrigger
						Value="N"
						Binding="{Binding ProgRelNode.CiteStd, ElementName=progRelPrograms}">
						<Setter
							Property="IsEnabled"
							Value="True" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</FrameworkElement.Style>
		<StackPanel
			Orientation="Horizontal"
			DockPanel.Dock="Top">
			<Button
				Height="20"
				Click="Add_Click">
				<Image
					Source="pack://application:,,,/SpecDesigner.SpecEditor;component/Images/item_add.png"
					Height="9"
					Width="9" />
			</Button>
			<Button
				Height="20"
				Margin="3 0"
				Click="Delete_Click">
				<Image
					Source="pack://application:,,,/SpecDesigner.SpecEditor;component/Images/item_delete.png"
					Height="9"
					Width="9" />
			</Button>
		</StackPanel>
		<DataGrid
			x:Name="ProgramsDataGrid"
			AutoGenerateColumns="False"
			SelectionUnit="FullRow"
			ItemsSource="{Binding ProgRelNode.Programs, ElementName=progRelPrograms}">
			<FrameworkElement.ContextMenu>
				<ContextMenu>
					<MenuItem
						Header="Add"
						Click="Add_Click" />
					<MenuItem
						Header="Delete"
						Click="Delete_Click" />
				</ContextMenu>
			</FrameworkElement.ContextMenu>
			<DataGrid.Columns>
				<DataGridTemplateColumn
					Header="{StaticResource specProperty_prog_rel_type}"
					Width="Auto">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock
								Text="{Binding TypeName}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
					<DataGridTemplateColumn.CellEditingTemplate>
						<DataTemplate>
							<ComboBox
								DisplayMemberPath="Text"
								SelectedValuePath="Type"
								ItemsSource="{Binding Types}"
								SelectedValue="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellEditingTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Header="{StaticResource specProperty_prog_rel_program}"
					Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock
								Text="{Binding Program}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
					<DataGridTemplateColumn.CellEditingTemplate>
						<DataTemplate>
							<TextBox
								ch:TextBoxHelper.ButtonMode="Search"
								ch:TextBoxHelper.ButtonCommand="l:SpecPropertyCommands.ShowZoomsWindowCommand"
								Tag="prog_rel"
								ch:TextBoxHelper.ButtonCommandParameter="{Binding RelativeSource={RelativeSource Self}}"
								Text="{Binding Program, Mode=TwoWay, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellEditingTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
