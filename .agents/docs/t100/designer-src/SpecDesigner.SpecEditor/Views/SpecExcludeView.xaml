<UserControl
	x:Class="SpecDesigner.SpecEditor.Views.SpecExcludeView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:views="clr-namespace:SpecDesigner.SpecEditor.Views">
	<Grid>
		<DataGrid
			x:Name="excludeDataGrid"
			IsReadOnly="True"
			AutoGenerateColumns="False"
			ItemsSource="{Binding}">
			<DataGrid.RowStyle>
				<Style
					TargetType="{x:Type DataGridRow}">
					<EventSetter
						Event="MouseDoubleClick"
						Handler="excludeDataGrid_MouseDoubleClick" />
				</Style>
			</DataGrid.RowStyle>
			<DataGrid.Columns>
				<DataGridTextColumn
					Header="{StaticResource specProperty_name}"
					Width="*"
					Binding="{Binding}" />
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>
