<UserControl
	x:Class="SpecDesigner.SpecEditor.SpecPropertyEditor"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
	xmlns:helper="clr-namespace:SpecDesigner.SpecEditor.Helpers"
	xmlns:views="clr-namespace:SpecDesigner.SpecEditor.Views"
	xmlns:ctrls="clr-namespace:SpecDesigner.SpecEditor.Controls"
	xmlns:System="clr-namespace:System;assembly=mscorlib"
	xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
	xmlns:ch="clr-namespace:SpecDesigner.Controls.Controls;assembly=SpecDesigner.Controls"
	xmlns:l="clr-namespace:SpecDesigner.SpecEditor"
	xmlns:comh="clr-namespace:SpecDesignerCommon.Helpers;assembly=SpecDesignerCommon"
	xmlns:pf="clr-namespace:SpecDesignerPreference;assembly=SpecDesignerCommon"
	x:Name="editor">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<System:String
				x:Key="regCheckValue">[^a-zA-Z0-9_.-]</System:String>
			<Style
				x:Key="{x:Type CheckBox}"
				TargetType="{x:Type CheckBox}"
				BasedOn="{StaticResource {x:Type CheckBox}}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
			</Style>
			<Style
				x:Key="aggTB"
				TargetType="{x:Type TextBox}">
				<Style.Triggers>
					<DataTrigger
						Value="True"
						Binding="{Binding IsChecked, ElementName=aggregateCB}">
						<Setter
							Property="Visibility"
							Value="Visible" />
					</DataTrigger>
					<DataTrigger
						Value="False"
						Binding="{Binding IsChecked, ElementName=aggregateCB}">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<Style
				x:Key="aggLB"
				TargetType="{x:Type TextBlock}">
				<Style.Triggers>
					<DataTrigger
						Value="True"
						Binding="{Binding IsChecked, ElementName=aggregateCB}">
						<Setter
							Property="Visibility"
							Value="Visible" />
					</DataTrigger>
					<DataTrigger
						Value="False"
						Binding="{Binding IsChecked, ElementName=aggregateCB}">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<Style
				x:Key="repeatCB"
				TargetType="{x:Type ComboBox}">
				<Style.Triggers>
					<DataTrigger
						Value="True"
						Binding="{Binding IsChecked, ElementName=repeatCB}">
						<Setter
							Property="Visibility"
							Value="Visible" />
					</DataTrigger>
					<DataTrigger
						Value="False"
						Binding="{Binding IsChecked, ElementName=repeatCB}">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<Style
				x:Key="repeatTB"
				TargetType="{x:Type TextBox}">
				<Style.Triggers>
					<DataTrigger
						Value="True"
						Binding="{Binding IsChecked, ElementName=repeatCB}">
						<Setter
							Property="Visibility"
							Value="Visible" />
					</DataTrigger>
					<DataTrigger
						Value="False"
						Binding="{Binding IsChecked, ElementName=repeatCB}">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<Style
				x:Key="repeatLB"
				TargetType="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Style.Triggers>
					<DataTrigger
						Value="True"
						Binding="{Binding IsChecked, ElementName=repeatCB}">
						<Setter
							Property="Visibility"
							Value="Visible" />
					</DataTrigger>
					<DataTrigger
						Value="False"
						Binding="{Binding IsChecked, ElementName=repeatCB}">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<Style
				x:Key="aggCB"
				TargetType="{x:Type ComboBox}">
				<Style.Triggers>
					<DataTrigger
						Value="True"
						Binding="{Binding IsChecked, ElementName=aggregateCB}">
						<Setter
							Property="Visibility"
							Value="Visible" />
					</DataTrigger>
					<DataTrigger
						Value="False"
						Binding="{Binding IsChecked, ElementName=aggregateCB}">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<helper:BooleanCheckedConverter
				x:Key="booleanCheckedConverter" />
			<helper:TitleAttributeVisibilityConverter
				x:Key="TitleAttributeVisibilityConverter" />
			<helper:TextAttributeVisibilityConverter
				x:Key="TextAttributeVisibilityConverter" />
			<helper:TableTreeColumnVisibilityConverter
				x:Key="TableTreeColumnVisibilityConverter" />
			<helper:SpecTreeAttVisibilityConverter
				x:Key="SpecTreeAttVisibilityConverter" />
			<helper:HelpCodeVisibleConverter
				x:Key="HelpCodeVisibleConverter" />
			<helper:MultiNullVisibilityConveter
				x:Key="MultiNullVisibilityConveter" />
			<helper:MultiBooleanCheckedConverter
				x:Key="multiBooleanCheckedConverter" />
			<helper:MutiComboValueConveter
				x:Key="MutiComboValueConveter" />
			<helper:MutiTextValueConveter
				x:Key="MutiTextValueConveter" />
			<helper:ConstrucInputValueConverter
				x:Key="ConstrucInputValueConverter" />
			<helper:MultiVisibilityConverter
				x:Key="MultiVisibilityConverter" />
			<helper:BoolToVisibilityConverter
				x:Key="BoolToVisibilityConverter" />
			<helper:LocalizedPropertyMultiConverter
				x:Key="LocalizedPropertyMultiConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		x:Name="LayoutRoot">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Grid
			x:Name="citeStdGrid"
			Visibility="Collapsed"
			Margin="2">
			<CheckBox
				x:Name="citeStdCheckBox"
				Content="{StaticResource specProperty_citeStd}"
				FontSize="14"
				IsChecked="{Binding IsCited}"
				PreviewMouseLeftButtonDown="citeStdCheckBox_PreviewMouseLeftButtonDown">
				<FrameworkElement.Style>
					<Style
						BasedOn="{StaticResource {x:Type CheckBox}}"
						TargetType="{x:Type CheckBox}">
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding CitedSpec, Mode=OneWay}"
								Value="{x:Null}">
								<Setter
									Property="IsEnabled"
									Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
			</CheckBox>
		</Grid>
		<ScrollViewer
			VerticalScrollBarVisibility="Auto"
			Grid.Row="1"
			Grid.IsSharedSizeScope="True"
			HorizontalScrollBarVisibility="Disabled">
			<StackPanel>
				<Expander
					x:Name="FieldExcludeSetting"
					Header="{StaticResource specProperty_SpecFieldExcludeSetting}"
					IsExpanded="True"
					VerticalAlignment="Top">
					<ch:SpecUniformGrid
						Margin="8,2,2,2">
						<TextBlock
							Height="22"
							Text="{StaticResource specProperty_SpecFieldExcude}" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="Auto" />
							</Grid.ColumnDefinitions>
							<CheckBox
								x:Name="excludeCB"
								IsChecked="{Binding Path=IsExcluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							<Button
								x:Name="excludeViewBtn"
								Content="..."
								Grid.Column="1"
								Click="excludeViewBtn_Click" />
						</Grid>
					</ch:SpecUniformGrid>
				</Expander>
				<Expander
					x:Name="FieldSpecGroup1"
					IsExpanded="True"
					VerticalAlignment="Top"
					Header="{StaticResource specProperty_SpecAttirbuteSetting}"
					ch:ControlsHelper.IsCited="{Binding IsCited, Mode=OneWay}">
					<ch:SpecUniformGrid
						Margin="8,2,2,2">
						<ch:PropertyLabel
							Label="{StaticResource specProperty_table}"
							Focusable="False"
							IsHitTestVisible="False" />
						<ComboBox
							x:Name="cb_tables"
							SelectedValue="{Binding Table}"
							ItemsSource="{Binding TableList}"
							SelectionChanged="cb_tables_SelectionChanged">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<VirtualizingStackPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource {x:Type ComboBox}}"
									TargetType="{x:Type ComboBox}">
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding GeneroComponent.IsCantDel, Mode=OneWay}">
											<Setter
												Property="IsEnabled"
												Value="False" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</ComboBox>
						<TextBlock
							Height="22"
							Text="{StaticResource specProperty_table_name}"
							IsHitTestVisible="False" />
						<TextBox
							x:Name="cb_table_name"
							HorizontalAlignment="Stretch"
							IsReadOnly="True" />
						<ch:PropertyLabel
							Label="{StaticResource specProperty_column}"
							Focusable="False"
							IsHitTestVisible="False" />
						<ComboBox
							x:Name="cb_fields"
							SelectedValue="{Binding Column, UpdateSourceTrigger=LostFocus, Mode=TwoWay, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"
							ItemsSource="{Binding TableColumns}"
							SelectionChanged="cb_fields_SelectionChanged"
							LostFocus="cb_fields_LostFocus">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<VirtualizingStackPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource {x:Type ComboBox}}"
									TargetType="{x:Type ComboBox}">
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding GeneroComponent.IsCantDel, Mode=OneWay}">
											<Setter
												Property="IsEnabled"
												Value="False" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</ComboBox>
						<TextBlock
							Height="22"
							Text="{StaticResource specProperty_column_name}"
							IsHitTestVisible="False" />
						<TextBox
							x:Name="column_name"
							IsTabStop="False"
							IsReadOnly="True"
							HorizontalAlignment="Stretch" />
						<TextBlock
							Height="22"
							Text="{StaticResource specProperty_attribute}"
							IsHitTestVisible="False" />
						<TextBox
							x:Name="column_type"
							IsReadOnly="True"
							HorizontalAlignment="Stretch"
							IsTabStop="False" />
						<TextBlock
							Height="22"
							Text="{StaticResource specProperty_type}"
							IsHitTestVisible="False">
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource MultiVisibilityConverter}"
									ConverterParameter="specProperty_type">
									<Binding
										Path="Attribute" />
									<Binding
										Path="Widget" />
									<Binding
										Path="Widget" />
									<Binding
										Source="{x:Static pf:PreferenceManager.Current}"
										Path="Settings.StandardView" />
									<Binding
										Path="[style]" />
								</MultiBinding>
							</UIElement.Visibility>
						</TextBlock>
						<TextBox
							x:Name="column_type2"
							IsReadOnly="True"
							HorizontalAlignment="Stretch"
							IsTabStop="False">
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource MultiVisibilityConverter}"
									ConverterParameter="specProperty_type">
									<Binding
										Path="Attribute" />
									<Binding
										Path="Widget" />
									<Binding
										Path="Widget" />
									<Binding
										Source="{x:Static pf:PreferenceManager.Current}"
										Path="Settings.StandardView" />
									<Binding
										Path="[style]" />
								</MultiBinding>
							</UIElement.Visibility>
						</TextBox>
						<ch:PropertyLabel
							Label="{StaticResource specProperty_req}"
							Focusable="False"
							IsHitTestVisible="False" />
						<CheckBox
							HorizontalAlignment="Stretch"
							IsChecked="{Binding Req, Mode=TwoWay, Converter={helper:CheckedValueConverter}}"
							Click="CheckBox_Checked">
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource {x:Type CheckBox}}"
									TargetType="{x:Type CheckBox}">
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding GeneroComponent.IsCantDel}">
											<Setter
												Property="IsEnabled"
												Value="False" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</CheckBox>
						<ch:PropertyLabel
							Label="{StaticResource specProperty_i_zoom}"
							Focusable="False"
							IsHitTestVisible="False">
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource MultiVisibilityConverter}"
									ConverterParameter="specProperty_i_zoom">
									<Binding
										Path="IZoom" />
									<Binding
										Path="Widget" />
									<Binding
										Path="Widget" />
									<Binding
										Source="{x:Static pf:PreferenceManager.Current}"
										Path="Settings.StandardView" />
									<Binding
										Path="[style]" />
								</MultiBinding>
							</UIElement.Visibility>
						</ch:PropertyLabel>
						<TextBox
							ch:TextBoxHelper.ButtonMode="Search"
							ch:TextBoxHelper.ButtonCommand="l:SpecPropertyCommands.ShowZoomsWindowCommand"
							Tag="i_zoom"
							HorizontalAlignment="Stretch"
							ch:TextBoxHelper.ButtonCommandParameter="{Binding RelativeSource={RelativeSource Self}}"
							Text="{Binding IZoom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource {x:Type TextBox}}"
									TargetType="{x:Type TextBox}">
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding GeneroComponent.IsCantDel}">
											<Setter
												Property="TextBoxBase.IsReadOnly"
												Value="True" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource MultiVisibilityConverter}"
									ConverterParameter="specProperty_i_zoom">
									<Binding
										Path="IZoom" />
									<Binding
										Path="Widget" />
									<Binding
										Path="Widget" />
									<Binding
										Source="{x:Static pf:PreferenceManager.Current}"
										Path="Settings.StandardView" />
									<Binding
										Path="[style]" />
								</MultiBinding>
							</UIElement.Visibility>
						</TextBox>
						<ch:PropertyLabel
							Label="{StaticResource specProperty_c_zoom}"
							Focusable="False"
							IsHitTestVisible="False">
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource MultiVisibilityConverter}"
									ConverterParameter="specProperty_c_zoom">
									<Binding
										Path="CZoom" />
									<Binding
										Path="Widget" />
									<Binding
										Path="Widget" />
									<Binding
										Source="{x:Static pf:PreferenceManager.Current}"
										Path="Settings.StandardView" />
									<Binding
										Path="[style]" />
								</MultiBinding>
							</UIElement.Visibility>
						</ch:PropertyLabel>
						<TextBox
							x:Name="c_zoom_btn"
							ch:TextBoxHelper.ButtonMode="Search"
							ch:TextBoxHelper.ButtonCommand="l:SpecPropertyCommands.ShowZoomsWindowCommand"
							Tag="c_zoom"
							HorizontalAlignment="Stretch"
							ch:TextBoxHelper.ButtonCommandParameter="{Binding RelativeSource={RelativeSource Self}}"
							Text="{Binding CZoom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource {x:Type TextBox}}"
									TargetType="{x:Type TextBox}">
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding GeneroComponent.IsCantDel}">
											<Setter
												Property="TextBoxBase.IsReadOnly"
												Value="True" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource MultiVisibilityConverter}"
									ConverterParameter="specProperty_c_zoom">
									<Binding
										Path="CZoom" />
									<Binding
										Path="Widget" />
									<Binding
										Path="Widget" />
									<Binding
										Source="{x:Static pf:PreferenceManager.Current}"
										Path="Settings.StandardView" />
									<Binding
										Path="[style]" />
								</MultiBinding>
							</UIElement.Visibility>
						</TextBox>
						<ch:PropertyLabel
							Label="{StaticResource specProperty_chk_ref}"
							Focusable="False"
							IsHitTestVisible="False">
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource MultiVisibilityConverter}"
									ConverterParameter="specProperty_chk_ref">
									<Binding
										Path="ChkRef" />
									<Binding
										Path="Widget" />
									<Binding
										Path="Widget" />
									<Binding
										Source="{x:Static pf:PreferenceManager.Current}"
										Path="Settings.StandardView" />
									<Binding
										Path="[style]" />
								</MultiBinding>
							</UIElement.Visibility>
						</ch:PropertyLabel>
						<TextBox
							ch:TextBoxHelper.ButtonMode="Search"
							ch:TextBoxHelper.ButtonCommand="l:SpecPropertyCommands.ShowZoomsWindowCommand"
							Tag="chk_ref"
							HorizontalAlignment="Stretch"
							ch:TextBoxHelper.ButtonCommandParameter="{Binding RelativeSource={RelativeSource Self}}"
							Text="{Binding ChkRef, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource {x:Type TextBox}}"
									TargetType="{x:Type TextBox}">
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding GeneroComponent.IsCantDel}">
											<Setter
												Property="TextBoxBase.IsReadOnly"
												Value="True" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource MultiVisibilityConverter}"
									ConverterParameter="specProperty_chk_ref">
									<Binding
										Path="ChkRef" />
									<Binding
										Path="Widget" />
									<Binding
										Path="Widget" />
									<Binding
										Source="{x:Static pf:PreferenceManager.Current}"
										Path="Settings.StandardView" />
									<Binding
										Path="[style]" />
								</MultiBinding>
							</UIElement.Visibility>
						</TextBox>
						<ch:PropertyLabel
							x:Name="editTitle"
							Label="{StaticResource specProperty_canEdit}"
							Focusable="False"
							IsHitTestVisible="False" />
						<CheckBox
							x:Name="editValue"
							HorizontalAlignment="Stretch"
							IsChecked="{Binding CanEdit, Mode=TwoWay, Converter={helper:CheckedValueConverter}}">
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource {x:Type CheckBox}}"
									TargetType="{x:Type CheckBox}">
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding GeneroComponent.IsCantDel}">
											<Setter
												Property="IsEnabled"
												Value="False" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</CheckBox>
						<ch:PropertyLabel
							x:Name="queryTitle"
							Label="{StaticResource specProperty_canQuery}"
							Focusable="False"
							IsHitTestVisible="False" />
						<CheckBox
							x:Name="queryValue"
							HorizontalAlignment="Stretch"
							IsChecked="{Binding CanQuery, Mode=TwoWay, Converter={helper:CheckedValueConverter}}">
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource {x:Type CheckBox}}"
									TargetType="{x:Type CheckBox}">
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding GeneroComponent.IsCantDel}">
											<Setter
												Property="IsEnabled"
												Value="False" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</CheckBox>
						<ch:PropertyLabel
							x:Name="queryEditTitle"
							Label="{StaticResource specProperty_canQueryEdit}"
							Focusable="False"
							IsHitTestVisible="False" />
						<ComboBox
							x:Name="queryEditValue"
							SelectedValuePath="Tag"
							HorizontalAlignment="Stretch"
							SelectedValue="{Binding ElementName=FieldSpecGroup1, Path=DataContext, Converter='{StaticResource ConstrucInputValueConverter}', Mode=TwoWay}">
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource {x:Type ComboBox}}"
									TargetType="{x:Type ComboBox}">
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding GeneroComponent.IsCantDel}">
											<Setter
												Property="IsEnabled"
												Value="False" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
							<ComboBoxItem
								Tag="CONSTRUCT">CONSTRUCT</ComboBoxItem>
							<ComboBoxItem
								Tag="INPUT">INPUT</ComboBoxItem>
							<ComboBoxItem
								Tag="NONE"
								Content="{StaticResource specProperty_noQuery}" />
						</ComboBox>
						<ch:PropertyLabel
							Label="{StaticResource specProperty_name}"
							Focusable="False"
							IsHitTestVisible="False" />
						<ch:WatermarkTextBox
							x:Name="field_name"
							IsRequired="True"
							RegexCheck="{StaticResource regCheckValue}"
							input:InputMethod.IsInputMethodEnabled="False"
							Text="{Binding Name, Mode=TwoWay, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}">
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource {x:Type ch:WatermarkTextBox}}"
									TargetType="{x:Type ch:WatermarkTextBox}">
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding GeneroComponent.IsCantDel, Mode=OneWay}">
											<Setter
												Property="TextBoxBase.IsReadOnly"
												Value="True" />
										</DataTrigger>
										<DataTrigger
											Value="True"
											Binding="{Binding IsReadOnly, Mode=OneWay}">
											<Setter
												Property="TextBoxBase.IsReadOnly"
												Value="True" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</ch:WatermarkTextBox>
						<ch:PropertyLabel
							Label="{StaticResource specProperty_items}"
							Focusable="False"
							IsHitTestVisible="False">
							<UIElement.Visibility>
								<MultiBinding
									Converter="{StaticResource MultiVisibilityConverter}"
									ConverterParameter="specProperty_items">
									<Binding
										Path="Items" />
									<Binding
										Path="Widget" />
									<Binding
										Path="Widget" />
									<Binding
										Source="{x:Static pf:PreferenceManager.Current}"
										Path="Settings.StandardView" />
									<Binding
										Path="[style]" />
								</MultiBinding>
							</UIElement.Visibility>
						</ch:PropertyLabel>
						<TextBox
							Tag="items"
							IsReadOnly="True"
							HorizontalAlignment="Stretch"
							Text="{Binding Items, Mode=OneWay}">
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource {x:Type TextBox}}"
									TargetType="{x:Type TextBox}">
