<Window
	x:Class="SpecDesigner.SpecEditor.Controls.TableSchemaAssociationWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:linq="clr-namespace:System.Xml.Linq;assembly=System.Xml.Linq"
	xmlns:local="clr-namespace:SpecDesigner.SpecEditor.Controls"
	xmlns:helper="clr-namespace:SpecDesigner.SpecEditor.Helpers"
	Title="{StaticResource menu_TableSchemaAssocSetting}"
	Height="300"
	Width="350">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<local:ObjectToTypeStringConverter
				x:Key="ObjectToTypeStringConverter" />
			<local:ModelHierarchyDataTemplateSelector
				x:Key="ModelHierarchyDataTemplateSelector" />
			<helper:CheckedValueConverter
				x:Key="CheckedValueConverter" />
			<Style
				x:Key="{x:Type TreeViewItem}"
				TargetType="{x:Type TreeViewItem}">
				<Setter
					Property="TreeViewItem.IsExpanded"
					Value="True" />
				<Setter
					Property="HorizontalContentAlignment"
					Value="Stretch" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TreeViewItem}">
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<helper:LineVisibilityConverter
										x:Key="LineVisibilityConverter" />
									<helper:FirstLeafLineMarginConverter
										x:Key="FirstLeafLineMarginConverter" />
									<helper:TreeViewItemToLineTranslateTransformFactor
										x:Key="TreeViewItemToLineTranslateTransformFactor" />
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										MinWidth="19"
										Width="Auto" />
									<ColumnDefinition
										Width="*" />
									<ColumnDefinition
										Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
									<RowDefinition />
								</Grid.RowDefinitions>
								<Line
									X1="0"
									X2="10"
									Fill="#00FFFFFF"
									RenderOptions.EdgeMode="Aliased"
									Stroke="#808080"
									VerticalAlignment="Center"
									HorizontalAlignment="Right"
									StrokeDashArray="1 1">
									<UIElement.RenderTransform>
										<TranslateTransform
											Y="2" />
									</UIElement.RenderTransform>
								</Line>
								<Line
									Stretch="Fill"
									Y1="0"
									Y2="1"
									RenderOptions.EdgeMode="Aliased"
									Grid.RowSpan="2"
									Stroke="#808080"
									StrokeDashArray="1 1"
									HorizontalAlignment="Center"
									Visibility="{Binding ConverterParameter=Line, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LineVisibilityConverter}}">
									<UIElement.RenderTransform>
										<TranslateTransform
											Y="{Binding ActualHeight, ElementName=PART_Header, Converter={StaticResource TreeViewItemToLineTranslateTransformFactor}}" />
									</UIElement.RenderTransform>
								</Line>
								<Line
									Y1="0"
									Y2="1"
									Stretch="Fill"
									RenderOptions.EdgeMode="Aliased"
									Stroke="#808080"
									StrokeDashArray="1 1"
									VerticalAlignment="Stretch"
									HorizontalAlignment="Center"
									Visibility="{Binding ConverterParameter=FirstLeafLine, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LineVisibilityConverter}}"
									Margin="{Binding ActualHeight, ElementName=PART_Header, Converter={StaticResource FirstLeafLineMarginConverter}}" />
								<ToggleButton
									x:Name="Expander"
									ClickMode="Press"
									IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
									<FrameworkElement.Style>
										<Style
											TargetType="{x:Type ToggleButton}">
											<Setter
												Property="Focusable"
												Value="False" />
											<Setter
												Property="Width"
												Value="16" />
											<Setter
												Property="Height"
												Value="16" />
											<Setter
												Property="Template">
												<Setter.Value>
													<ControlTemplate
														TargetType="{x:Type ToggleButton}">
														<Border
															Height="9"
															Width="9"
															BorderBrush="#808080"
															BorderThickness="1"
															CornerRadius="1"
															SnapsToDevicePixels="True">
															<Border.Background>
																<LinearGradientBrush
																	EndPoint="0,1"
																	StartPoint="0,0">
																	<GradientStop
																		Color="#FCFCFC"
																		Offset="0" />
																	<GradientStop
																		Color="#E3E3E3"
																		Offset="1" />
																</LinearGradientBrush>
															</Border.Background>
															<Grid
																SnapsToDevicePixels="True">
																<Rectangle
																	Height="1"
																	Width="5"
																	Stroke="#4B63A7"
																	SnapsToDevicePixels="True" />
																<Rectangle
																	x:Name="CrossHorizontalLine"
																	Height="5"
																	Width="1"
																	Stroke="#4B63A7"
																	SnapsToDevicePixels="True" />
															</Grid>
														</Border>
														<ControlTemplate.Triggers>
															<Trigger
																Property="ToggleButton.IsChecked"
																Value="True">
																<Setter
																	TargetName="CrossHorizontalLine"
																	Property="Visibility"
																	Value="Collapsed" />
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</FrameworkElement.Style>
									<UIElement.RenderTransform>
										<TranslateTransform
											Y="1" />
									</UIElement.RenderTransform>
								</ToggleButton>
								<Border
									x:Name="Bd"
									BorderBrush="{TemplateBinding Control.BorderBrush}"
									BorderThickness="{TemplateBinding Control.BorderThickness}"
									Background="{TemplateBinding Control.Background}"
									Grid.Column="1"
									Grid.ColumnSpan="2"
									Padding="{TemplateBinding Control.Padding}"
									SnapsToDevicePixels="True">
									<Grid>
										<ContentPresenter
											x:Name="PART_Header"
											ContentSource="Header"
											SnapsToDevicePixels="True" />
									</Grid>
								</Border>
								<ItemsPresenter
									x:Name="ItemsHost"
									Grid.ColumnSpan="2"
									Grid.Column="1"
									Grid.Row="1"
									SnapsToDevicePixels="True" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="TreeViewItem.IsExpanded"
									Value="False">
									<Setter
										TargetName="ItemsHost"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="ItemsControl.HasItems"
									Value="False">
									<Setter
										TargetName="Expander"
										Property="Visibility"
										Value="Hidden" />
								</Trigger>
								<Trigger
									Property="TreeViewItem.IsSelected"
									Value="True">
									<Setter
										TargetName="Bd"
										Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
										Property="Border.Background" />
									<Setter
										Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
										Property="Foreground" />
								</Trigger>
								<MultiTrigger>
									<MultiTrigger.Conditions>
										<Condition
											Property="TreeViewItem.IsSelected"
											Value="True" />
										<Condition
											Property="TreeViewItem.IsSelectionActive"
											Value="False" />
									</MultiTrigger.Conditions>
									<Setter
										TargetName="Bd"
										Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
										Property="Border.Background" />
									<Setter
										Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
										Property="Foreground" />
								</MultiTrigger>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
										Property="Foreground" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<DataTemplate
				x:Key="AddButtonTemplate">
				<Grid>
					<Image
						x:Name="img"
						Source="/SpecDesigner.SpecEditor;component/Images/plus.png" />
				</Grid>
				<DataTemplate.Triggers>
					<DataTrigger
						Value="False"
						Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
						<Setter
							TargetName="img"
							Property="UIElement.Visibility"
							Value="Hidden" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
			<DataTemplate
				x:Key="ModifyButtonTemplate">
				<Grid>
					<Image
						x:Name="img"
						Source="/SpecDesigner.SpecEditor;component/Images/edit.png" />
				</Grid>
				<DataTemplate.Triggers>
					<DataTrigger
						Value="False"
						Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
						<Setter
							TargetName="img"
							Property="UIElement.Visibility"
							Value="Hidden" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
			<DataTemplate
				x:Key="DelButtonTemplate">
				<Grid>
					<Image
						x:Name="img"
						Source="/SpecDesigner.SpecEditor;component/Images/delete.png" />
				</Grid>
				<DataTemplate.Triggers>
					<DataTrigger
						Value="False"
						Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
						<Setter
							TargetName="img"
							Property="UIElement.Visibility"
							Value="Hidden" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
			<DataTemplate
				x:Key="ApplyButtonTemplate">
				<Grid>
					<Image
						Source="/SpecDesigner.SpecEditor;component/Images/check_simple.png" />
				</Grid>
			</DataTemplate>
			<ObjectDataProvider
				x:Key="TablesProvider" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		x:Name="LayoutRoot">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="100" />
		</Grid.RowDefinitions>
		<GroupBox
			Header="Schema Setting"
			Margin="5">
			<TreeView
				x:Name="tablesTreeView"
				ItemTemplateSelector="{StaticResource ModelHierarchyDataTemplateSelector}"
				ItemsSource="{Binding Tbls}"
				SelectedItemChanged="tablesTreeView_SelectedItemChanged"
				TreeViewItem.Selected="tablesTreeView_Selected">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<HierarchicalDataTemplate
							x:Key="TblModelTemplate"
							DataType="{x:Type local:TblModel}"
							ItemsSource="{Binding Path=Tbls}">
							<Grid
								x:Name="XXXXX"
								Height="20"
								HorizontalAlignment="Left">
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition />
									<ColumnDefinition />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
								<Image
									Source="pack://application:,,,/SpecDesigner.FormEditor;component/Images/widget_table.png"
									Width="16"
									Height="16"
									HorizontalAlignment="Left"
									Grid.Column="0" />
								<TextBlock
									x:Name="ReadonlyTB"
									VerticalAlignment="Center"
									Visibility="Visible"
									Grid.Column="1"
									Margin="5 0 0 0"
									Text="{Binding Name}" />
								<ComboBox
									x:Name="EditableTB"
									Grid.Column="1"
									Visibility="Collapsed"
									DisplayMemberPath="Attribute[name].Value"
									SelectedValuePath="Attribute[name].Value"
									Text="{Binding Name, UpdateSourceTrigger=Explicit}"
									ItemsSource="{Binding Source={StaticResource TablesProvider}}"
									FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
									KeyDown="EditableTB_KeyDown" />
								<StackPanel
									x:Name="stackPanel"
									Orientation="Horizontal"
									Grid.Column="2"
									Visibility="Hidden">
									<Button
										x:Name="ApplyButton"
										HorizontalAlignment="Right"
										Visibility="Hidden"
										ContentTemplate="{DynamicResource ApplyButtonTemplate}"
										Click="ApplyButton_Click" />
									<Button
										x:Name="ModifyButton"
										HorizontalAlignment="Right"
										ContentTemplate="{DynamicResource ModifyButtonTemplate}"
										Click="ModifyButton_Click" />
									<Button
										x:Name="AddButton"
										HorizontalAlignment="Right"
										ContentTemplate="{StaticResource AddButtonTemplate}"
										Command="{Binding AddCommand}" />
									<Button
										x:Name="DelButton"
										HorizontalAlignment="Right"
										ContentTemplate="{DynamicResource DelButtonTemplate}"
										Command="{Binding DeleteCommand}" />
								</StackPanel>
								<Grid
									Column="3"
									VerticalAlignment="Center"
									MinWidth="120">
									<TextBlock
										Text="{Binding DisplayName}" />
								</Grid>
							</Grid>
							<DataTemplate.Triggers>
								<MultiDataTrigger>
									<MultiDataTrigger.Conditions>
										<Condition
											Value="True"
											Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}}" />
									</MultiDataTrigger.Conditions>
									<Setter
										TargetName="EditableTB"
										Property="UIElement.Visibility"
										Value="Collapsed" />
									<Setter
										TargetName="ReadonlyTB"
										Property="UIElement.Visibility"
										Value="Visible" />
									<Setter
										TargetName="stackPanel"
										Property="UIElement.Visibility"
										Value="Visible" />
								</MultiDataTrigger>
								<MultiDataTrigger>
									<MultiDataTrigger.Conditions>
										<Condition
											Value="False"
											Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}}" />
									</MultiDataTrigger.Conditions>
									<Setter
										TargetName="EditableTB"
										Property="UIElement.Visibility"
										Value="Collapsed" />
									<Setter
										TargetName="ReadonlyTB"
										Property="UIElement.Visibility"
										Value="Visible" />
									<Setter
										TargetName="stackPanel"
										Property="UIElement.Visibility"
										Value="Hidden" />
								</MultiDataTrigger>
							</DataTemplate.Triggers>
						</HierarchicalDataTemplate>
						<HierarchicalDataTemplate
							x:Key="SRModelTemplate"
							DataType="{x:Type local:SRModel}">
							<StackPanel
								Orientation="Horizontal">
								<Image
									Source="pack://application:,,,/SpecDesigner.FormEditor;component/Images/screenRecord.png"
									VerticalAlignment="Center"
									Width="16"
									Height="16" />
								<TextBlock
									Margin="5,0,5,0"
									VerticalAlignment="Center"
									Text="{Binding SRName}" />
								<CheckBox
									VerticalAlignment="Center"
									IsChecked="{Binding Cascade, Converter={StaticResource CheckedValueConverter}}" />
							</StackPanel>
						</HierarchicalDataTemplate>
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</TreeView>
		</GroupBox>
		<GroupBox
			Header="PK/FK"
			Grid.Row="1"
			Margin="5">
			<FrameworkElement.Style>
				<Style
					TargetType="{x:Type GroupBox}">
					<Setter
						Property="IsEnabled"
						Value="False" />
					<Style.Triggers>
						<DataTrigger
							Value="TblModel"
							Binding="{Binding SelectedValue, ElementName=tablesTreeView, Converter='{StaticResource ObjectToTypeStringConverter}'}">
							<Setter
								Property="IsEnabled"
								Value="True" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</FrameworkElement.Style>
			<Canvas
				VerticalAlignment="Top"
				HorizontalAlignment="Left">
				<TextBlock
					Text="Primary Key:"
					Canvas.Left="5"
					Canvas.Top="4" />
				<TextBlock
					Text="FK Target:"
					Canvas.Left="6"
					Canvas.Top="28" />
				<TextBlock
					Text="FK Source:"
					Canvas.Left="6"
					Canvas.Top="52" />
				<TextBox
					x:Name="pkTextBox"
					Canvas.Left="80"
					Canvas.Top="1"
					Width="150"
					Text="{Binding SelectedItem.PK, ElementName=tablesTreeView}" />
				<TextBox
					x:Name="fkTextBox"
					Width="150"
					Canvas.Left="80"
					Canvas.Top="49"
					Text="{Binding SelectedItem.Fk_Target, ElementName=tablesTreeView}" />
				<TextBox
					Width="150"
					Canvas.Left="80"
					Canvas.Top="25"
					Text="{Binding SelectedItem.Fk_Source, ElementName=tablesTreeView}" />
			</Canvas>
		</GroupBox>
	</Grid>
</Window>
