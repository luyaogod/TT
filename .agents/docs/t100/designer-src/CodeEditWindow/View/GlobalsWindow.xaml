<Window
	x:Class="SpecDesigner.CodeEditWindow.View.GlobalsWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:h="clr-namespace:SpecDesigner.CodeEditWindow.View"
	xmlns:i="clr-namespace:SpecDesigner.Infrastructure;assembly=Infrastructure"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	ResizeMode="CanResizeWithGrip"
	WindowStyle="SingleBorderWindow"
	Title="top_global.inc">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				x:Key="{x:Type Paragraph}"
				TargetType="{x:Type Paragraph}">
				<Setter
					Property="Block.LineHeight"
					Value="1" />
				<Setter
					Property="FontFamily"
					Value="Consolas" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<ScrollViewer>
			<TextBlock
				Text="{Binding}" />
		</ScrollViewer>
		<Button
			Grid.Row="1"
			HorizontalAlignment="Stretch"
			Margin="2"
			BorderThickness="1"
			BorderBrush="#FF000000"
			Content="{StaticResource Button_Close}"
			Click="Close_Click" />
	</Grid>
</Window>
