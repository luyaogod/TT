<Window
	x:Class="SpecDesigner.CodeEditWindow.View.DiffBaseOnStandardWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:code="clr-namespace:SpecDesigner.CodeEditWindow.View"
	xmlns:ch="clr-namespace:SpecDesigner.CodeEditWindow.Helper;assembly=CodeEditWindow"
	xmlns:ci="clr-namespace:SpecDesigner.Infrastructure.Helper;assembly=Infrastructure"
	WindowStartupLocation="CenterOwner">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<BooleanToVisibilityConverter
				x:Key="BoolToVis" />
			<Style
				x:Key="{x:Type Label}"
				TargetType="{x:Type Label}">
				<Setter
					Property="FontSize"
					Value="16" />
				<Setter
					Property="BorderBrush"
					Value="#FF000000" />
				<Setter
					Property="BorderThickness"
					Value="0,0,0,1" />
				<Setter
					Property="HorizontalContentAlignment"
					Value="Center" />
			</Style>
			<Style
				x:Key="buttonImageStyle"
				TargetType="{x:Type Image}">
				<Setter
					Property="Height"
					Value="24" />
				<Setter
					Property="Width"
					Value="24" />
				<Setter
					Property="Stretch"
					Value="Uniform" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="5*" />
			<RowDefinition
				Height="95*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="49*" />
			<ColumnDefinition
				Width="5" />
			<ColumnDefinition
				Width="49*" />
		</Grid.ColumnDefinitions>
		<ToolBarTray
			Orientation="Horizontal"
			IsLocked="True"
			Grid.Row="0"
			Grid.ColumnSpan="3">
			<ToolBar>
				<Button
					Command="ci:DiffCommands.BaseOnStandardSaveCommand"
					ToolTip="{StaticResource menu_FileSave}">
					<FrameworkElement.Style>
						<Style
							BasedOn="{StaticResource ToolBarButtonBaseStyle}"
							TargetType="{x:Type Button}">
							<Setter
								Property="Content">
								<Setter.Value>
									<Image
										Source="/Images/save_dark.png"
										Style="{StaticResource buttonImageStyle}" />
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										Property="Content">
										<Setter.Value>
											<Image
												Source="/Images/save_gray.png"
												Style="{StaticResource buttonImageStyle}" />
										</Setter.Value>
									</Setter>
								</Trigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
				</Button>
				<Button
					Command="ci:DiffCommands.ToNextDiffLineCommand"
					ToolTip="{StaticResource menu_ToNextDiffLine}">
					<FrameworkElement.Style>
						<Style
							BasedOn="{StaticResource ToolBarButtonBaseStyle}"
							TargetType="{x:Type Button}">
							<Setter
								Property="Content">
								<Setter.Value>
									<Image
										Source="/Images/point_down_dark.png"
										Style="{StaticResource buttonImageStyle}" />
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										Property="Content">
										<Setter.Value>
											<Image
												Source="/Images/point_down_gray.png"
												Style="{StaticResource buttonImageStyle}" />
										</Setter.Value>
									</Setter>
								</Trigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
				</Button>
				<Button
					Command="ci:DiffCommands.ToPreviousDiffLineCommand"
					ToolTip="{StaticResource menu_ToPreviousDiffLine}">
					<FrameworkElement.Style>
						<Style
							BasedOn="{StaticResource ToolBarButtonBaseStyle}"
							TargetType="{x:Type Button}">
							<Setter
								Property="Content">
								<Setter.Value>
									<Image
										Source="/Images/point_up_dark.png"
										Style="{StaticResource buttonImageStyle}" />
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										Property="Content">
										<Setter.Value>
											<Image
												Source="/Images/point_up_gray.png"
												Style="{StaticResource buttonImageStyle}" />
										</Setter.Value>
									</Setter>
								</Trigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
				</Button>
				<Button
					Command="ch:CodeEditCommands.DiffBlockCopyContent"
					ToolTip="{StaticResource CE_DiffBlockCopyContent}">
					<FrameworkElement.Style>
						<Style
							BasedOn="{StaticResource ToolBarButtonBaseStyle}"
							TargetType="{x:Type Button}">
							<Setter
								Property="Content">
								<Setter.Value>
									<Image
										Source="/Images/copy_block_dark.png"
										Style="{StaticResource buttonImageStyle}" />
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										Property="Content">
										<Setter.Value>
											<Image
												Source="/Images/copy_block_gray.png"
												Style="{StaticResource buttonImageStyle}" />
										</Setter.Value>
									</Setter>
								</Trigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
				</Button>
				<Button
					Command="ch:CodeEditCommands.DiffLineCopyContent"
					ToolTip="{StaticResource CE_DiffLineCopyContent}">
					<FrameworkElement.Style>
						<Style
							BasedOn="{StaticResource ToolBarButtonBaseStyle}"
							TargetType="{x:Type Button}">
							<Setter
								Property="Content">
								<Setter.Value>
									<Image
										Source="/Images/copy_single_dark.png"
										Style="{StaticResource buttonImageStyle}" />
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										Property="Content">
										<Setter.Value>
											<Image
												Source="/Images/copy_single_gray.png"
												Style="{StaticResource buttonImageStyle}" />
										</Setter.Value>
									</Setter>
								</Trigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
				</Button>
			</ToolBar>
		</ToolBarTray>
		<Button
			x:Name="button"
			Grid.Column="2"
			Grid.Row="0"
			Content="{StaticResource codeEditor_Diff}"
			Width="100"
			HorizontalAlignment="Right"
			Visibility="{Binding IsDiff, Converter='{StaticResource BoolToVis}'}"
			Click="button_Click" />
		<Grid
			x:Name="viewer1"
			Row="1"
			Column="0">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
		</Grid>
		<GridSplitter
			Grid.Row="1"
			Grid.Column="1"
			Margin="0,2,0,2"
			HorizontalAlignment="Stretch"
			ShowsPreview="True" />
		<Grid
			x:Name="viewer2"
			Column="2"
			Row="1">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
		</Grid>
	</Grid>
</Window>
