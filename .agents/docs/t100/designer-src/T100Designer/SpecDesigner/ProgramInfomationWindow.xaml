<Window
	x:Class="SpecDesigner.ProgramInfomationWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:SpecDesigner.Converters"
	Height="300"
	Width="300"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	ResizeMode="NoResize"
	SizeToContent="WidthAndHeight"
	xmlns:specdesigner="clr-namespace:SpecDesigner">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				x:Key="{x:Type TextBox}"
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}">
				<Setter
					Property="TextBoxBase.IsReadOnly"
					Value="True" />
				<Setter
					Property="Margin"
					Value="0 2 0 2" />
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
			</Style>
			<Style
				x:Key="{x:Type TextBlock}"
				TargetType="{x:Type TextBlock}"
				BasedOn="{StaticResource {x:Type TextBlock}}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="Margin"
					Value="0 0 5 0" />
			</Style>
			<Style
				x:Key="{x:Type CheckBox}"
				TargetType="{x:Type CheckBox}"
				BasedOn="{StaticResource {x:Type CheckBox}}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="IsEnabled"
					Value="False" />
			</Style>
			<c:ValueCheckedConverter
				x:Key="valueCheckedConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UniformGrid
		Columns="2"
		Margin="5">
		<TextBlock
			Text="{StaticResource ProgramInformation_Prog}" />
		<TextBox
			Text="{Binding Attribute[prog].Value, Mode=OneWay}" />
		<TextBlock
			x:Name="stdprogTitle"
			Text="{StaticResource ProgramInformation_Std_Prog}" />
		<TextBox
			x:Name="stdporgValue"
			Text="{Binding Attribute[std_prog].Value, Mode=OneWay}" />
		<TextBlock
			Text="{StaticResource ProgramInformation_ErpVer}" />
		<TextBox
			Text="{Binding Attribute[erpver].Value, Mode=OneWay}" />
		<TextBlock
			Text="{StaticResource ProgramInformation_Ver}" />
		<TextBox
			Text="{Binding Attribute[ver].Value, Mode=OneWay}" />
		<TextBlock
			Text="{StaticResource ProgramInformation_Module}" />
		<TextBox
			Text="{Binding Attribute[module].Value, Mode=OneWay}" />
		<TextBlock
			x:Name="typeTitle"
			Text="{StaticResource ProgramInformation_Type}" />
		<TextBox
			x:Name="typeValue"
			Text="{Binding Attribute[type].Value, Mode=OneWay}" />
		<TextBlock
			Text="{StaticResource ProgramInformation_Booking}" />
		<CheckBox
			IsChecked="{Binding Attribute[booking].Value, Mode=OneWay, Converter='{StaticResource valueCheckedConverter}'}" />
		<TextBlock
			x:Name="classTitle"
			Text="{StaticResource ProgramInformation_Class}" />
		<TextBox
			x:Name="classValue"
			Text="{Binding Attribute[class].Value, Mode=OneWay}" />
		<TextBlock
			Text="{StaticResource ProgramInformation_Env}" />
		<TextBox
			Text="{Binding Attribute[env].Value, Mode=OneWay}" />
		<TextBlock
			Text="{StaticResource ProgramInformation_Zone}" />
		<TextBox
			Text="{Binding Attribute[zone].Value, Mode=OneWay}" />
		<TextBlock
			Text="{StaticResource ProgramInformation_Identity}" />
		<TextBox
			Text="{Binding Attribute[identity].Value, Mode=OneWay}" />
		<TextBlock
			x:Name="sectionTitle"
			Text="{StaticResource ProgramInformation_SectionFlag}" />
		<CheckBox
			x:Name="sectionValue"
			IsChecked="{Binding Attribute[section_flag].Value, Mode=OneWay, Converter='{StaticResource valueCheckedConverter}'}" />
		<TextBlock
			x:Name="templateTitle"
			Text="{StaticResource ProgramInformation_Template}" />
		<TextBox
			x:Name="templateValue"
			Text="{Binding Element[other].Element[code_template].Attribute[value].Value, Mode=OneWay}" />
		<TextBlock
			x:Name="freeStyleTitle"
			Text="{StaticResource ProgramInformation_FreeStyle}" />
		<CheckBox
			x:Name="freeStyleVale"
			IsChecked="{Binding Element[other].Element[free_style].Attribute[value].Value, Mode=OneWay, Converter='{StaticResource valueCheckedConverter}'}" />
	</UniformGrid>
</Window>
