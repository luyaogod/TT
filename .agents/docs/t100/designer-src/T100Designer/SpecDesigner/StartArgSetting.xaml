<Window
	x:Class="SpecDesigner.StartArgSetting"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:SpecDesigner"
	WindowStyle="SingleBorderWindow"
	ResizeMode="NoResize"
	SizeToContent="WidthAndHeight"
	WindowStartupLocation="CenterScreen">
	<Grid
		x:Name="CTSelectorRoot">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid
			Margin="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Grid.Row="0"
				Text="{StaticResource codeProperty_StartArg}" />
			<TextBox
				x:Name="startArgBox"
				Grid.Row="0"
				Grid.Column="1"
				Style="{StaticResource TextBoxErrorStyle}">
				<TextBox.Text>
					<Binding
						Path="StartArg"
						UpdateSourceTrigger="PropertyChanged"
						NotifyOnValidationError="True">
						<Binding.ValidationRules>
							<local:NumbericValidationRule />
						</Binding.ValidationRules>
					</Binding>
				</TextBox.Text>
			</TextBox>
		</Grid>
		<TextBlock
			Grid.Row="1"
			Text="{StaticResource Message_PropertyChange}"
			Margin="5"
			Foreground="#FFFF0000"
			FontWeight="Bold" />
		<Grid
			Row="2">
			<Separator
				VerticalAlignment="Top" />
			<StackPanel
				Orientation="Horizontal"
				HorizontalAlignment="Right"
				Margin="8">
				<Button
					x:Name="acceptButton"
					Content="{StaticResource Button_OK}"
					MinWidth="100"
					Margin="4"
					Click="acceptButton_Click" />
				<Button
					x:Name="cancelButton"
					Content="{StaticResource Button_Cancel}"
					MinWidth="100"
					Margin="4"
					Click="cancelButton_Click" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>
