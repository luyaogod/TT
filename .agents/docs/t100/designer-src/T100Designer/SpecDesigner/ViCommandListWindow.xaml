<Window
	x:Class="SpecDesigner.ViCommandListWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Name="Window"
	Title="{StaticResource VI_CommandList}"
	WindowStyle="SingleBorderWindow"
	ResizeMode="NoResize"
	SizeToContent="WidthAndHeight"
	WindowStartupLocation="CenterOwner"
	xmlns:specdesigner="clr-namespace:SpecDesigner">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				x:Key="{x:Type TextBlock}"
				TargetType="{x:Type TextBlock}">
				<Setter
					Property="Margin"
					Value="0 4" />
				<Setter
					Property="Foreground"
					Value="#FF000000" />
			</Style>
			<Style
				x:Key="{x:Type GroupBox}"
				TargetType="{x:Type GroupBox}">
				<Setter
					Property="Margin"
					Value="5" />
				<Setter
					Property="Foreground"
					Value="#FF0000FF" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<StackPanel
		x:Name="LayoutRoot"
		Orientation="Vertical">
		<StackPanel
			Orientation="Horizontal">
			<GroupBox
				Header="{StaticResource VI_GeneralMode}">
				<StackPanel
					Margin="5">
					<TextBlock
						Text="{StaticResource VI_MoveOneLeft}" />
					<TextBlock
						Text="{StaticResource VI_MoveNLeft}" />
					<TextBlock
						Text="{StaticResource VI_MoveOneUp}" />
					<TextBlock
						Text="{StaticResource VI_MoveNUp}" />
					<TextBlock
						Text="{StaticResource VI_MoveOneDown}" />
					<TextBlock
						Text="{StaticResource VI_MoveNDown}" />
					<TextBlock
						Text="{StaticResource VI_MoveOneRight}" />
					<TextBlock
						Text="{StaticResource VI_MoveNRight}" />
					<TextBlock
						Text="{StaticResource VI_MoveToLastLine}" />
					<TextBlock
						Text="{StaticResource VI_MoveToNLine}" />
					<TextBlock
						Text="{StaticResource VI_ScrollDown}" />
					<TextBlock
						Text="{StaticResource VI_ScrollUp}" />
					<TextBlock
						Text="{StaticResource VI_Save}" />
					<TextBlock
						Text="{StaticResource VI_SearchCurrentWord}" />
					<TextBlock
						Text="{StaticResource VI_SelectLineMode}" />
					<TextBlock
						Text="{StaticResource VI_SelectBlockMode}" />
					<TextBlock
						Text="{StaticResource VI_ExecuteLastCommand}" />
				</StackPanel>
			</GroupBox>
			<GroupBox
				Header="">
				<StackPanel
					Margin="5">
					<TextBlock
						Text="{StaticResource VI_DelCharAtCursor}" />
					<TextBlock
						Text="{StaticResource VI_DelCharBeforeCursor}" />
					<TextBlock
						Text="{StaticResource VI_DelEntireLine}" />
					<TextBlock
						Text="{StaticResource VI_DelNLines}" />
					<TextBlock
						Text="{StaticResource VI_CopyEntireLine}" />
					<TextBlock
						Text="{StaticResource VI_CopyNLine}" />
					<TextBlock
						Text="{StaticResource VI_PasteBeforeCursor}" />
					<TextBlock
						Text="{StaticResource VI_PasteAfterCursor}" />
					<TextBlock
						Text="{StaticResource VI_Undo}" />
					<TextBlock
						Text="{StaticResource VI_Redo}" />
					<TextBlock
						Text="{StaticResource VI_SearchDown}" />
					<TextBlock
						Text="{StaticResource VI_SearchUpwards}" />
					<TextBlock
						Text="{StaticResource VI_MoveUpToNextSearchString}" />
					<TextBlock
						Text="{StaticResource VI_MoveDownToNextSearchString}" />
				</StackPanel>
			</GroupBox>
			<StackPanel>
				<GroupBox
					Header="{StaticResource VI_EditMode}">
					<StackPanel
						Margin="5">
						<TextBlock
							Text="{StaticResource VI_AddDataBeforeCursor}" />
						<TextBlock
							Text="{StaticResource VI_AddDataBeforeLine}" />
						<TextBlock
							Text="{StaticResource VI_AddDataAfterCursor}" />
						<TextBlock
							Text="{StaticResource VI_AddDataAfterLine}" />
						<TextBlock
							Text="{StaticResource VI_AddLineBelowLine}" />
						<TextBlock
							Text="{StaticResource VI_AddLineAboveLine}" />
						<TextBlock
							Text="{StaticResource VI_LeaveEditModeEnterGeneralMode}" />
					</StackPanel>
				</GroupBox>
				<GroupBox
					Header="{StaticResource VI_ReplaceMode}">
					<StackPanel
						Margin="5">
						<TextBlock
							Text="{StaticResource VI_EnterReplaceModeUntilESC}" />
					</StackPanel>
				</GroupBox>
			</StackPanel>
		</StackPanel>
		<GroupBox
			Header="{StaticResource VI_CommandMode}">
			<StackPanel
				Margin="5">
				<TextBlock
					Text="{StaticResource VI_EnterCommandModeUntilESC}" />
				<TextBlock
					Text="{StaticResource VI_ReplaceTextFromMToNLine}" />
				<TextBlock
					Text="{StaticResource VI_ReplaceTextInWholeContext}" />
			</StackPanel>
		</GroupBox>
	</StackPanel>
</Window>
