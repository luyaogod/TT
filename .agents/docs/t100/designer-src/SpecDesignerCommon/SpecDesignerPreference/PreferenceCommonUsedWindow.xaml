<UserControl
	x:Class="SpecDesignerPreference.PreferenceCommonUsedWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:l="clr-namespace:SpecDesignerPreference"
	xmlns:h="clr-namespace:SpecDesignerPreference.Helper"
	xmlns:ch="clr-namespace:SpecDesigner.Controls.Controls;assembly=SpecDesigner.Controls"
	xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
	x:Name="this">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				x:Key="{x:Type TextBlock}"
				TargetType="{x:Type TextBlock}">
				<Setter
					Property="Margin"
					Value="5" />
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
			</Style>
			<Style
				x:Key="{x:Type TextBox}"
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}">
				<Setter
					Property="Margin"
					Value="5" />
				<Setter
					Property="HorizontalAlignment"
					Value="Stretch" />
			</Style>
			<h:ContentConverter
				x:Key="ContentConverter" />
			<Style
				x:Key="{x:Type ListBox}"
				TargetType="{x:Type ListBox}">
				<Setter
					Property="ItemTemplate">
					<Setter.Value>
						<DataTemplate>
							<WrapPanel>
								<TextBlock
									Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
								<TextBlock
									Text=" : " />
								<TextBlock
									Text="{Binding Desc, UpdateSourceTrigger=PropertyChanged}" />
							</WrapPanel>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				Text="{StaticResource Preference_ProgramName}" />
			<TextBox
				x:Name="ProgramName"
				Grid.Row="0"
				Grid.Column="1"
				ch:TextBoxHelper.ButtonMode="Search"
				ch:TextBoxHelper.ButtonCommand="l:PreferenceCommands.ShowProgramNoWindowCommand"
				ch:TextBoxHelper.ButtonCommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
			<TextBlock
				Grid.Row="1"
				Grid.Column="0"
				Text="{StaticResource Preference_ProgramDesc}" />
			<TextBox
				x:Name="ProgramDesc"
				Grid.Row="1"
				Grid.Column="1" />
			<TextBlock
				Grid.Row="2"
				Grid.Column="0"
				Text="{StaticResource Preference_ProgramPreview}" />
			<Label
				Grid.Row="2"
				Grid.Column="1"
				Content="r.r" />
			<TextBlock
				x:Name="PreviewText"
				Grid.Row="2"
				Grid.Column="1"
				Text="{Binding ElementName=ProgramName, Path=Text, Mode=OneWay, Converter='{StaticResource ContentConverter}'}" />
			<Button
				x:Name="Add"
				Grid.Row="0"
				Grid.Column="2"
				Content="{StaticResource Preference_Add}"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				Visibility="Visible"
				Click="AddButton_Click" />
			<Button
				x:Name="Modify"
				Grid.Row="0"
				Grid.Column="2"
				Content="{StaticResource Preference_Modify}"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				Visibility="Collapsed"
				Click="Modify_Click" />
			<Button
				x:Name="Cancle_B"
				Grid.Row="0"
				Grid.Column="3"
				Content="{StaticResource Preference_Cancel}"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				Visibility="Collapsed"
				Click="Cancle_Click" />
		</Grid>
		<Separator
			Grid.Row="1"
			Margin="0,5,0,0" />
		<Grid
			Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="50*" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="50*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				Text="{StaticResource Preference_Disable}"
				HorizontalAlignment="Center" />
			<TextBlock
				Grid.Row="0"
				Grid.Column="2"
				Text="{StaticResource Preference_Enable}"
				HorizontalAlignment="Center" />
			<ListBox
				x:Name="Disable"
				Grid.Row="1"
				Grid.Column="0"
				Margin="5"
				AllowDrop="True"
				SelectionMode="Single"
				DisplayMemberPath="Name"
				SelectedValuePath="Sort"
				ItemsSource="{Binding DisableList}"
				SelectionChanged="ListBox_SelectionChanged">
				<FrameworkElement.ContextMenu>
					<ContextMenu>
						<MenuItem
							Header="{StaticResource Preference_Delete}"
							Click="DisableMenuItemDelete_Click" />
					</ContextMenu>
				</FrameworkElement.ContextMenu>
			</ListBox>
			<StackPanel
				Grid.Row="1"
				Grid.Column="1"
				VerticalAlignment="Center"
				HorizontalAlignment="Center">
				<Button
					Name="EnableButton"
					Margin="0 5"
					Click="EnableButton_Click">
					<Image
						Source="pack://application:,,,/SpecDesignerCommon;component/Preference/Images/navigate_right.png"
						Width="16" />
				</Button>
				<Button
					Name="DisableButton"
					Margin="0 5"
					Click="DisableButton_Click">
					<Image
						Source="pack://application:,,,/SpecDesignerCommon;component/Preference/Images/navigate_left.png"
						Width="16" />
				</Button>
			</StackPanel>
			<ListBox
				x:Name="Enable"
				Grid.Row="1"
				Grid.Column="2"
				Margin="5"
				AllowDrop="True"
				SelectionMode="Single"
				DisplayMemberPath="Name"
				SelectedValuePath="Sort"
				ItemsSource="{Binding EnableList}"
				SelectionChanged="ListBox_SelectionChanged">
				<FrameworkElement.ContextMenu>
					<ContextMenu>
						<MenuItem
							Header="{StaticResource Preference_Delete}"
							Click="EnableMenuItemDelete_Click" />
					</ContextMenu>
				</FrameworkElement.ContextMenu>
			</ListBox>
		</Grid>
	</Grid>
</UserControl>
