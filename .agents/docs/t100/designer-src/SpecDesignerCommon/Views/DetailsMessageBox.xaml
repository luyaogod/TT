<Window
	x:Class="SpecDesignerCommon.Views.DetailsMessageBox"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helper="clr-namespace:SpecDesignerCommon.Helpers"
	x:Name="_this"
	Style="{DynamicResource MessageBox}"
	Title="MessageBox"
	WindowStartupLocation="CenterOwner"
	Width="400"
	SizeToContent="Height"
	xmlns:views="clr-namespace:SpecDesignerCommon.Views"
	Loaded="this_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<helper:MessageBoxImageConverter
				x:Key="imageConverter" />
			<SolidColorBrush
				x:Key="MessageBoxBackgroundBrush"
				Color="White" />
			<SolidColorBrush
				x:Key="MessageBoxForegroundBrush"
				Color="Black" />
			<SolidColorBrush
				x:Key="MessageBoxBorderBrush"
				Color="#FFFFFFFF" />
			<Style
				x:Key="MessageBox"
				TargetType="{x:Type Window}">
				<Setter
					Property="Margin"
					Value="{Binding Margin}" />
				<Setter
					Property="Window.ResizeMode"
					Value="{Binding ResizeMode}" />
				<Setter
					Property="Window.WindowStyle"
					Value="{Binding WindowStyle}" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Window}">
							<Border
								BorderThickness="1"
								BorderBrush="{DynamicResource MessageBoxBorderBrush}"
								Background="{StaticResource MessageBoxBackgroundBrush}">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition />
										<RowDefinition
											Height="Auto" />
									</Grid.RowDefinitions>
									<ContentPresenter
										Content="{TemplateBinding ContentControl.Content}"
										Margin="{TemplateBinding FrameworkElement.Margin}" />
									<Expander
										Grid.Row="1"
										Header="Detailed Information">
										<Border
											BorderBrush="#FF000000"
											BorderThickness="1">
											<TextBox
												IsReadOnly="True"
												MaxHeight="400"
												TextWrapping="Wrap"
												HorizontalScrollBarVisibility="Auto"
												VerticalScrollBarVisibility="Auto"
												Foreground="{StaticResource MessageBoxForegroundBrush}"
												Background="{StaticResource MessageBoxBackgroundBrush}"
												Text="{Binding ElementName=_this, Path=DetailMessage}"
												MouseLeftButtonUp="MessageTextBox_MouseUp" />
										</Border>
									</Expander>
								</Grid>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<DockPanel
		LastChildFill="True">
		<UniformGrid
			DockPanel.Dock="Bottom"
			HorizontalAlignment="Right"
			Rows="1"
			Margin="2">
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<Style
						x:Key="{x:Type Button}"
						TargetType="{x:Type Button}">
						<Setter
							Property="Margin"
							Value="3,0,3,0" />
						<Setter
							Property="MinWidth"
							Value="50" />
					</Style>
				</ResourceDictionary>
			</FrameworkElement.Resources>
			<Button
				x:Name="_ok"
				Content="_OK"
				Visibility="Collapsed"
				Click="ok_Click" />
			<Button
				x:Name="_yes"
				Content="_Yes"
				Visibility="Collapsed"
				Click="yes_Click" />
			<Button
				x:Name="_no"
				Content="_No"
				Visibility="Collapsed"
				Click="no_Click" />
			<Button
				x:Name="_cancel"
				Content="_Cancel"
				Visibility="Collapsed"
				Click="cancel_Click" />
		</UniformGrid>
		<Image
			x:Name="_image"
			Width="32"
			Height="32"
			DockPanel.Dock="Left"
			Margin="20"
			Source="{Binding Converter='{StaticResource imageConverter}', ElementName=_this, Path=MessageBoxImage}" />
		<TextBlock
			Foreground="{StaticResource MessageBoxForegroundBrush}"
			TextWrapping="Wrap"
			VerticalAlignment="Center"
			Text="{Binding ElementName=_this, Path=Message}" />
	</DockPanel>
</Window>
