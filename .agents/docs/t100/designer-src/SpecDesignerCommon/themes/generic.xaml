<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:adCvr="clr-namespace:Xceed.Wpf.AvalonDock.Converters;assembly=Xceed.Wpf.AvalonDock"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="TitleBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFD3DAED" Offset="1" />
        <GradientStop Color="#FFFEFEFF" />
        <GradientStop Color="#FFE3E9F7" Offset="0.275" />
        <GradientStop Color="#FFD3DAED" Offset="1" />
        <GradientStop Color="#FFD3DAED" Offset="0.32" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CiteTitleBackground"
                         EndPoint="0.5,1"
                         StartPoint="0.5,0">
        <GradientStop Color="#FFF9F9F9"
                      Offset="1" />
        <GradientStop Color="#FFF9F9F9" />
        <GradientStop Color="#FFF1F1F1"
                      Offset="0.275" />
        <GradientStop Color="#FFE0E0E0"
                      Offset="1" />
        <GradientStop Color="#FFE0E0E0"
                      Offset="0.32" />
    </LinearGradientBrush>
    <adCvr:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

</ResourceDictionary>