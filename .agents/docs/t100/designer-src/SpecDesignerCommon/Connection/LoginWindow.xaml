<Window
	x:Class="SpecDesignerCommon.Connection.LoginWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
	xmlns:a="clr-namespace:SpecDesignerCommon.Connection.Adorner"
	xmlns:h="clr-namespace:SpecDesignerCommon.Connection.Helper"
	xmlns:l="clr-namespace:SpecDesignerCommon.Connection"
	x:Name="window"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	ResizeMode="NoResize"
	Width="300"
	SizeToContent="Height"
	Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				x:Key="{x:Type TextBlock}"
				TargetType="{x:Type TextBlock}">
				<Setter
					Property="Margin"
					Value="5" />
			</Style>
			<Style
				x:Key="{x:Type TextBox}"
				TargetType="{x:Type TextBox}"
				BasedOn="{StaticResource {x:Type TextBox}}">
				<Setter
					Property="Margin"
					Value="5" />
			</Style>
			<Style
				x:Key="{x:Type PasswordBox}"
				TargetType="{x:Type PasswordBox}"
				BasedOn="{StaticResource {x:Type PasswordBox}}">
				<Setter
					Property="Margin"
					Value="5" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		VerticalAlignment="Center"
		HorizontalAlignment="Stretch">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				MinWidth="100"
				Width="*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
		</Grid.RowDefinitions>
		<TextBlock
			Text="{StaticResource Site_ServerIP}"
			Grid.Row="0"
			Grid.Column="0" />
		<TextBox
			x:Name="IPBox"
			IsReadOnly="True"
			Grid.Row="0"
			Grid.Column="1"
			Text="{Binding ElementName=window, Path=Setting.Connection.IP, Mode=TwoWay}" />
		<TextBlock
			Text="{StaticResource Site_Login}"
			Grid.Row="1"
			Grid.Column="0" />
		<TextBox
			x:Name="loginBox"
			Grid.Row="1"
			Grid.Column="1"
			Text="{Binding ElementName=window, Path=Setting.Connection.Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			KeyDown="InputBox_KeyDown" />
		<TextBlock
			Text="{StaticResource Site_Password}"
			Grid.Row="2"
			Grid.Column="0" />
		<PasswordBox
			x:Name="password"
			Grid.Row="2"
			Grid.Column="1"
			h:PasswordHelper.Attach="True"
			h:PasswordHelper.Password="{Binding ElementName=window, Path=Setting.Connection.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			KeyDown="InputBox_KeyDown" />
		<TextBlock
			Grid.Row="3"
			Grid.Column="0"
			Text="{StaticResource Site_Area}" />
		<TextBox
			x:Name="areaBox"
			Grid.Row="3"
			Grid.Column="1"
			Text="{Binding ElementName=window, Path=Setting.Connection.Area, Mode=OneWay}"
			KeyDown="InputBox_KeyDown" />
		<StackPanel
			Grid.Row="4"
			Grid.ColumnSpan="2"
			Margin="5"
			Orientation="Horizontal"
			HorizontalAlignment="Center">
			<Button
				Content="{StaticResource Button_OK}"
				Width="100"
				Margin="5,0,5,0"
				Click="OKButton_Click" />
			<Button
				Content="{StaticResource Button_Cancel}"
				Width="100"
				Margin="5,0,5,0"
				Click="CancelButton_Click" />
		</StackPanel>
	</Grid>
</Window>
