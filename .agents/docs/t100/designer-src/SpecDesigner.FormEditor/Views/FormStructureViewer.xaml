<UserControl
	x:Class="SpecDesigner.FormEditor.Views.FormStructureViewer"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:views="clr-namespace:SpecDesigner.FormEditor.Views"
	xmlns:converter="clr-namespace:SpecDesigner.FormEditor.Helpers"
	xmlns:helper="clr-namespace:SpecDesigner.SpecEditor.Helpers;assembly=SpecDesigner.SpecEditor"
	xmlns:t="clr-namespace:SpecDesignerCommon.Helpers;assembly=SpecDesignerCommon"
	xmlns:ch="clr-namespace:SpecDesigner.Controls.Helpers;assembly=SpecDesigner.Controls"
	xmlns:b="clr-namespace:SpecDesigner.FormEditor.Behaviors"
	x:Name="formStructure">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<converter:IconImageControlConverter
				x:Key="IconImageControlConverter" />
			<Style
				x:Key="{x:Type TreeViewItem}"
				TargetType="{x:Type TreeViewItem}">
				<Style.Triggers>
					<DataTrigger
						Value="True"
						Binding="{Binding IsCantDel, Mode=OneWay}">
						<Setter
							Property="Foreground"
							Value="#FF808080" />
					</DataTrigger>
				</Style.Triggers>
				<Setter
					Property="TreeViewItem.IsExpanded"
					Value="{Binding IsExpanded, Mode=TwoWay}" />
				<Setter
					Property="b:TreeViewItemHelper.IsSelectedAndScrolling"
					Value="{Binding IsSelected, Mode=OneWay}" />
				<Setter
					Property="HorizontalContentAlignment"
					Value="Stretch" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TreeViewItem}">
							<FrameworkTemplate.Resources>
								<ResourceDictionary>
									<helper:LineVisibilityConverter
										x:Key="LineVisibilityConverter" />
									<helper:FirstLeafLineMarginConverter
										x:Key="FirstLeafLineMarginConverter" />
									<helper:TreeViewItemToLineTranslateTransformFactor
										x:Key="TreeViewItemToLineTranslateTransformFactor" />
								</ResourceDictionary>
							</FrameworkTemplate.Resources>
							<Grid>
								<i:Interaction.Triggers>
									<ch:HandlingEventTrigger
										EventName="MouseLeftButtonDown">
										<i:InvokeCommandAction
											Command="{Binding AppendSelectedCommand}" />
									</ch:HandlingEventTrigger>
								</i:Interaction.Triggers>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										MinWidth="19"
										Width="Auto" />
									<ColumnDefinition
										Width="*" />
									<ColumnDefinition
										Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
									<RowDefinition />
								</Grid.RowDefinitions>
								<Line
									X1="0"
									X2="10"
									IsHitTestVisible="False"
									Fill="#00FFFFFF"
									RenderOptions.EdgeMode="Aliased"
									Stroke="#808080"
									VerticalAlignment="Center"
									HorizontalAlignment="Right"
									StrokeDashArray="1 1">
									<UIElement.RenderTransform>
										<TranslateTransform
											Y="2" />
									</UIElement.RenderTransform>
								</Line>
								<Line
									Stretch="Fill"
									Y1="0"
									Y2="1"
									IsHitTestVisible="False"
									RenderOptions.EdgeMode="Aliased"
									Grid.RowSpan="2"
									Stroke="#808080"
									StrokeDashArray="1 1"
									HorizontalAlignment="Center"
									Visibility="{Binding ConverterParameter=Line, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LineVisibilityConverter}}">
									<UIElement.RenderTransform>
										<TranslateTransform
											Y="{Binding ActualHeight, ElementName=PART_Header, Converter={StaticResource TreeViewItemToLineTranslateTransformFactor}}" />
									</UIElement.RenderTransform>
								</Line>
								<Line
									IsHitTestVisible="False"
									Y1="0"
									Y2="1"
									Stretch="Fill"
									RenderOptions.EdgeMode="Aliased"
									Stroke="#808080"
									StrokeDashArray="1 1"
									VerticalAlignment="Stretch"
									HorizontalAlignment="Center"
									Visibility="{Binding ConverterParameter=FirstLeafLine, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LineVisibilityConverter}}"
									Margin="{Binding ActualHeight, ElementName=PART_Header, Converter={StaticResource FirstLeafLineMarginConverter}}" />
								<ToggleButton
									x:Name="Expander"
									ClickMode="Press"
									IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
									<FrameworkElement.Style>
										<Style
											TargetType="{x:Type ToggleButton}">
											<Setter
												Property="Focusable"
												Value="False" />
											<Setter
												Property="Width"
												Value="16" />
											<Setter
												Property="Height"
												Value="16" />
											<Setter
												Property="Template">
												<Setter.Value>
													<ControlTemplate
														TargetType="{x:Type ToggleButton}">
														<Border
															Height="9"
															Width="9"
															BorderBrush="#808080"
															BorderThickness="1"
															CornerRadius="1">
															<Border.Background>
																<LinearGradientBrush
																	EndPoint="0,1"
																	StartPoint="0,0">
																	<GradientStop
																		Color="#FCFCFC"
																		Offset="0" />
																	<GradientStop
																		Color="#E3E3E3"
																		Offset="1" />
																</LinearGradientBrush>
															</Border.Background>
															<Grid>
																<Rectangle
																	Height="1"
																	Width="5"
																	Stroke="#4B63A7" />
																<Rectangle
																	x:Name="CrossHorizontalLine"
																	Height="5"
																	Width="1"
																	Stroke="#4B63A7" />
															</Grid>
														</Border>
														<ControlTemplate.Triggers>
															<Trigger
																Property="ToggleButton.IsChecked"
																Value="True">
																<Setter
																	TargetName="CrossHorizontalLine"
																	Property="Visibility"
																	Value="Collapsed" />
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</FrameworkElement.Style>
									<UIElement.RenderTransform>
										<TranslateTransform
											Y="1" />
									</UIElement.RenderTransform>
								</ToggleButton>
								<Border
									x:Name="Bd"
									BorderBrush="{TemplateBinding Control.BorderBrush}"
									BorderThickness="{TemplateBinding Control.BorderThickness}"
									Background="{TemplateBinding Control.Background}"
									Grid.Column="1"
									Grid.ColumnSpan="2"
									Padding="{TemplateBinding Control.Padding}">
									<Grid>
										<ContentPresenter
											x:Name="PART_Header"
											ContentTemplate="{TemplateBinding HeaderedItemsControl.HeaderTemplate}"
											Content="{TemplateBinding HeaderedItemsControl.Header}"
											ContentStringFormat="{TemplateBinding HeaderedItemsControl.HeaderStringFormat}"
											ContentSource="Header"
											HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" />
									</Grid>
								</Border>
								<ItemsPresenter
									x:Name="ItemsHost"
									Grid.ColumnSpan="2"
									Grid.Column="1"
									Grid.Row="1" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									SourceName="Bd"
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="Bd"
										Value="{DynamicResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}"
										Property="Border.Background" />
								</Trigger>
								<Trigger
									Property="TreeViewItem.IsExpanded"
									Value="False">
									<Setter
										TargetName="ItemsHost"
										Property="Visibility"
										Value="Collapsed" />
								</Trigger>
								<Trigger
									Property="ItemsControl.HasItems"
									Value="False">
									<Setter
										TargetName="Expander"
										Property="Visibility"
										Value="Hidden" />
								</Trigger>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
										Property="Foreground" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<ContextMenu
				x:Key="uiTreeMenu">
				<MenuItem
					Header="Delete"
					Command="ApplicationCommands.Delete" />
				<MenuItem
					Header="Copy"
					Command="ApplicationCommands.Copy" />
				<MenuItem
					Header="Paste"
					Command="ApplicationCommands.Paste" />
			</ContextMenu>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<TreeView
			x:Name="UITree"
			AllowDrop="True"
			ContextMenu="{StaticResource uiTreeMenu}"
			ItemsSource="{Binding Nodes}"
			TreeViewItem.Selected="UITreeItem_Selected">
			<ItemsControl.ItemTemplate>
				<HierarchicalDataTemplate
					ItemsSource="{Binding Nodes}">
					<StackPanel
						Orientation="Horizontal">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type StackPanel}">
								<Style.Triggers>
									<DataTrigger
										Value="True"
										Binding="{Binding IsSelected, Mode=OneWay}">
										<Setter
											Property="Background"
											Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
						<Image
							Width="16"
							IsHitTestVisible="False"
							Height="16"
							VerticalAlignment="Center"
							Source="{Binding NodeName, Converter='{StaticResource IconImageControlConverter}'}"
							ToolTip="{Binding Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock
							IsHitTestVisible="False"
							Margin="5 2 0 2"
							VerticalAlignment="Center"
							Text="{Binding Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
				</HierarchicalDataTemplate>
			</ItemsControl.ItemTemplate>
		</TreeView>
		<Canvas
			x:Name="AdornerContainer"
			HorizontalAlignment="Left"
			VerticalAlignment="Top">
			<Rectangle
				x:Name="adornerElement"
				Stroke="#FFA4A4FF"
				StrokeThickness="2" />
			<Image
				x:Name="shadowCursor" />
		</Canvas>
		<Button
			Name="BtnExpandAll"
			Cursor="Hand"
			HorizontalAlignment="Right"
			Style="{StaticResource DesignerFlatButton}"
			ToolTip="Expand"
			VerticalAlignment="Top"
			Margin="0,0,27,0"
			Click="BtnExpandAll_Click">
			<Image
				Name="ImgExpandAll"
				Height="16"
				Margin="3"
				Source="pack://application:,,,/SpecDesigner.FormEditor;component/Images/folder_expand.png"
				Stretch="Uniform"
				Width="16" />
		</Button>
		<Button
			Name="BtnCollapseAll"
			Cursor="Hand"
			HorizontalAlignment="Right"
			Style="{StaticResource DesignerFlatButton}"
			ToolTip="Collapse"
			VerticalAlignment="Top"
			Margin="0,0,50,0"
			Click="BtnCollapseAll_Click">
			<Image
				Name="ImgCollapseAll"
				Height="16"
				Margin="3"
				Source="pack://application:,,,/SpecDesigner.FormEditor;component/Images/folder_collapse.png"
				Stretch="Uniform"
				Width="16" />
		</Button>
	</Grid>
</UserControl>
