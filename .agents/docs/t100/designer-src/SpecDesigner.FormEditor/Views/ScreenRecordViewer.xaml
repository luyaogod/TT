<UserControl
	x:Class="SpecDesigner.FormEditor.Views.ScreenRecordViewer"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:view="clr-namespace:SpecDesigner.FormEditor.Views"
	xmlns:helper="clr-namespace:SpecDesigner.FormEditor.Helpers"
	xmlns:views="clr-namespace:SpecDesigner.FormEditor.Views"
	Margin="2">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<helper:LocalStringsConverter
				x:Key="LocalStringsConverter" />
			<BitmapImage
				x:Key="RecordImage"
				UriSource="pack://application:,,,/SpecDesigner.FormEditor;component/Images/screenRecord.png" />
			<BitmapImage
				x:Key="RecordFieldImage"
				UriSource="pack://application:,,,/SpecDesigner.FormEditor;component/Images/variable_local.png" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<TabControl
		UseLayoutRounding="True">
		<TabItem
			Header="Records">
			<Grid>
				<TreeView
					ItemsSource="{Binding}"
					SelectedItemChanged="ScreenRecord_SelectedItemChanged">
					<ItemsControl.ItemContainerStyle>
						<Style
							TargetType="{x:Type TreeViewItem}">
							<Style.Triggers>
								<Trigger
									Property="TreeViewItem.IsSelected"
									Value="True">
									<Setter
										Property="FontWeight"
										Value="Normal" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</ItemsControl.ItemContainerStyle>
					<ItemsControl.ItemTemplate>
						<HierarchicalDataTemplate
							ItemsSource="{Binding Elements}">
							<Grid
								Height="18">
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="*" />
								</Grid.ColumnDefinitions>
								<Image
									Width="16"
									Height="16"
									VerticalAlignment="Center">
									<FrameworkElement.Style>
										<Style
											TargetType="{x:Type Image}">
											<Style.Triggers>
												<DataTrigger
													Value="Record"
													Binding="{Binding Name.LocalName}">
													<Setter
														Property="Source"
														Value="{StaticResource RecordImage}" />
												</DataTrigger>
												<DataTrigger
													Value="RecordField"
													Binding="{Binding Name.LocalName}">
													<Setter
														Property="Source"
														Value="{StaticResource RecordFieldImage}" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</FrameworkElement.Style>
								</Image>
								<TextBlock
									Grid.Column="1"
									VerticalAlignment="Center"
									Margin="5 2 0 2">
									<TextBlock.Text>
										<MultiBinding
											Converter="{StaticResource LocalStringsConverter}">
											<Binding
												Path="Attribute[name].Value" />
											<Binding
												Path="ProgramKey.Program"
												RelativeSource="{RelativeSource AncestorType={x:Type view:ScreenRecordViewer}}" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>
							</Grid>
						</HierarchicalDataTemplate>
					</ItemsControl.ItemTemplate>
				</TreeView>
				<Button
					Style="{StaticResource DesignerFlatButton}"
					VerticalAlignment="Top"
					HorizontalAlignment="Right"
					Cursor="Hand"
					ToolTip="Refresh"
					Click="ScreenRecordRefresh_Click">
					<Image
						Stretch="Uniform"
						Margin="5"
						Width="16"
						Height="16"
						Source="pack://application:,,,/SpecDesigner.FormEditor;component/Images/refresh.png" />
				</Button>
			</Grid>
		</TabItem>
		<TabItem
			Header="Form">
			<Grid>
				<views:FormStructureViewer
					x:Name="UITree" />
				<Button
					Style="{StaticResource DesignerFlatButton}"
					VerticalAlignment="Top"
					HorizontalAlignment="Right"
					Cursor="Hand"
					ToolTip="Refresh"
					Click="FormStructureRefresh_Click">
					<Image
						Stretch="Uniform"
						Margin="5"
						Width="16"
						Height="16"
						Source="pack://application:,,,/SpecDesigner.FormEditor;component/Images/refresh.png" />
				</Button>
			</Grid>
		</TabItem>
	</TabControl>
</UserControl>
