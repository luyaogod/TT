<UserControl
	x:Class="SpecDesigner.FormEditor.Views.TabIndexControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:c="clr-namespace:SpecDesigner.FormEditor.Converters"
	xmlns:my="clr-namespace:SpecDesigner.FormEditor.Views"
	FontFamily="Courier New"
	FontWeight="Bold"
	MinWidth="40"
	MinHeight="20"
	Background="#00FFFFFF"
	ToolTip="{Binding Name, Mode=OneWay}"
	Width="{Binding Width, Mode=OneWay}"
	Height="{Binding Height, Mode=OneWay}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<c:TabIndexBackgroundConverter
				x:Key="TabIndexBackgroundConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		VerticalAlignment="Center"
		HorizontalAlignment="Center">
		<Ellipse
			Stroke="#FFFFFFFF"
			StrokeThickness="1"
			MinWidth="40"
			MinHeight="18">
			<Shape.Fill>
				<MultiBinding
					Converter="{StaticResource TabIndexBackgroundConverter}">
					<Binding
						Path="TabIndex" />
					<Binding
						Path="Key" />
				</MultiBinding>
			</Shape.Fill>
		</Ellipse>
		<TextBlock
			Foreground="#FFFFFFFF"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			FontSize="14"
			Text="{Binding TabIndex, Mode=OneWay}" />
	</Grid>
</UserControl>
