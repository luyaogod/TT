<UserControl
	x:Class="SpecDesigner.FormEditor.Views.ManagedForm"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
	xmlns:helpers="clr-namespace:SpecDesigner.FormEditor.Helpers"
	xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
	xmlns:common="clr-namespace:SpecDesignerCommon;assembly=SpecDesignerCommon"
	xmlns:local="clr-namespace:SpecDesigner.FormEditor"
	xmlns:controls="clr-namespace:SpecDesigner.Controls.Controls;assembly=SpecDesigner.Controls"
	x:Name="managedForm"
	xmlns:views="clr-namespace:SpecDesigner.FormEditor.Views">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="pack://application:,,,/SpecDesigner.FormEditor;component/Themes/Generic.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Storyboard
				x:Key="OnMouseEnter1">
				<DoubleAnimationUsingKeyFrames
					Storyboard.TargetProperty="(UIElement.Opacity)"
					Storyboard.TargetName="scaleTool">
					<EasingDoubleKeyFrame
						KeyTime="0:0:0.5"
						Value="1" />
				</DoubleAnimationUsingKeyFrames>
			</Storyboard>
			<Storyboard
				x:Key="OnMouseLeave1">
				<DoubleAnimationUsingKeyFrames
					Storyboard.TargetProperty="(UIElement.Opacity)"
					Storyboard.TargetName="scaleTool">
					<EasingDoubleKeyFrame
						KeyTime="0:0:0.5"
						Value="0.2" />
				</DoubleAnimationUsingKeyFrames>
			</Storyboard>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<FrameworkElement.Triggers>
		<EventTrigger
			RoutedEvent="Mouse.MouseEnter"
			SourceName="scaleTool">
			<BeginStoryboard
				x:Name="OnMouseEnter1_BeginStoryboard"
				Storyboard="{StaticResource OnMouseEnter1}" />
		</EventTrigger>
		<EventTrigger
			RoutedEvent="Mouse.MouseLeave"
			SourceName="scaleTool">
			<BeginStoryboard
				x:Name="OnMouseLeave1_BeginStoryboard"
				Storyboard="{StaticResource OnMouseLeave1}" />
		</EventTrigger>
	</FrameworkElement.Triggers>
	<Grid
		x:Name="DesignContainer"
		UseLayoutRounding="True">
		<common:Watermark
			x:Name="notBookingWatermark" />
		<ScrollViewer
			x:Name="scroll"
			HorizontalScrollBarVisibility="Auto"
			VerticalScrollBarVisibility="Auto"
			controls:ScrollBarHelper.IsZoomable="True">
			<Grid
				x:Name="main_panel"
				Margin="5"
				RequestBringIntoView="scroll_RequestBringIntoView">
				<AdornerDecorator>
					<ContentControl
						x:Name="fromContent"
						ContentTemplate="{StaticResource FormTemplate}"
						VerticalAlignment="Top"
						HorizontalAlignment="Left"
						UseLayoutRounding="True"
						Content="{Binding FormNode}" />
				</AdornerDecorator>
			</Grid>
		</ScrollViewer>
		<Button
			x:Name="output4fd"
			Content="Output 4fd"
			Height="20"
			Width="100"
			Visibility="Collapsed"
			HorizontalAlignment="Right"
			VerticalAlignment="Bottom"
			Opacity="0.2"
			Click="output4fd_Click" />
		<StackPanel
			x:Name="scaleTool"
			VerticalAlignment="Top"
			HorizontalAlignment="Right"
			Margin="0,0,15,0">
			<Button
				HorizontalAlignment="Center"
				Style="{StaticResource DesignerAttachedButton}"
				Click="Zoom_Click">
				<Image
					Source="pack://application:,,,/SpecDesigner.FormEditor;component/Images/viewmag.png"
					Width="16"
					Stretch="Uniform" />
			</Button>
		</StackPanel>
	</Grid>
</UserControl>
