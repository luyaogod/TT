								<ch:HandlingEventTrigger
									EventName="MouseLeftButtonDown">
									<i:InvokeCommandAction
										Command="{Binding AppendSelectedCommand}" />
								</ch:HandlingEventTrigger>
								<ch:HandlingEventTrigger
									EventName="MouseRightButtonDown">
									<i:InvokeCommandAction
										Command="{Binding SelectedSelfCommand}" />
								</ch:HandlingEventTrigger>
