<UserControl
	x:Class="SpecDesigner.FormEditor.DBStructure.DBStructureUISelector"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:SpecDesigner.FormEditor.DBStructure"
	xmlns:System="clr-namespace:System;assembly=mscorlib"
	x:Name="uiSelector">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				x:Key="{x:Type TextBlock}"
				TargetType="{x:Type TextBlock}">
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<ScrollViewer>
			<StackPanel>
				<GroupBox
					Header="{StaticResource DBStructure_Container}">
					<ListBox
						x:Name="ContainerListBox"
						HorizontalAlignment="Center"
						SelectedIndex="0"
						SelectedItem="{Binding Container.Container, ElementName=uiSelector, Mode=OneWayToSource}"
						ItemsSource="{Binding Containers, ElementName=uiSelector}">
						<FrameworkElement.Resources>
							<ResourceDictionary>
								<Style
									x:Key="{x:Type ListBoxItem}"
									TargetType="{x:Type ListBoxItem}">
									<Style.Resources>
										<ResourceDictionary>
											<SolidColorBrush
												x:Key="{x:Static SystemColors.HighlightBrushKey}"
												Color="Blue" />
											<SolidColorBrush
												x:Key="{x:Static SystemColors.ControlBrushKey}"
												Color="Blue" />
										</ResourceDictionary>
									</Style.Resources>
								</Style>
							</ResourceDictionary>
						</FrameworkElement.Resources>
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel
									Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border
									CornerRadius="3"
									Margin="5"
									BorderBrush="#FF707070"
									BorderThickness="1">
									<Border.Background>
										<LinearGradientBrush
											EndPoint="0.5,1"
											StartPoint="0.5,0">
											<GradientStop
												Color="#FFF2F2F2"
												Offset="0" />
											<GradientStop
												Color="#FFD0D0D0"
												Offset="1" />
											<GradientStop
												Color="#FFF2F2F2"
												Offset="0.409" />
											<GradientStop
												Color="#FFD0D0D0"
												Offset="0.668" />
										</LinearGradientBrush>
									</Border.Background>
									<Image
										Width="64"
										Margin="3"
										Source="{Binding ImageSource}"
										ToolTip="{Binding Type}" />
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ListBox>
				</GroupBox>
				<GroupBox
					Header="{StaticResource DBStructure_FieldsAndLabels}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<StackPanel
							VerticalAlignment="Center">
							<Button
								Margin="0 5"
								ToolTip="Move to top"
								Focusable="False"
								Click="TopButton_Click">
								<Image
									Source="images/navigate_2up.png" />
							</Button>
							<Button
								Margin="0 5"
								ToolTip="Move up"
								Focusable="False"
								Click="UpButton_Click">
								<Image
									Source="images/navigate_up.png" />
							</Button>
							<Button
								Margin="0 5"
								ToolTip="Move down"
								Focusable="False"
								Click="DownButton_Click">
								<Image
									Source="images/navigate_down.png" />
							</Button>
							<Button
								Margin="0 5"
								ToolTip="Move to bottom"
								Focusable="False"
								Click="BottomButton_Click">
								<Image
									Source="images/navigate_2down.png" />
							</Button>
						</StackPanel>
						<DataGrid
							x:Name="DataGridFields"
							MaxHeight="200"
							Grid.Column="1"
							AutoGenerateColumns="False"
							CanUserAddRows="False"
							ItemsSource="{Binding SelectedFields.Source, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type local:DBStructureUISelector}}}">
							<DataGrid.RowStyle>
								<Style
									TargetType="{x:Type DataGridRow}">
									<Setter
										Property="DataGridRow.IsSelected"
										Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Style>
							</DataGrid.RowStyle>
							<DataGrid.Columns>
								<DataGridTemplateColumn
									Header="{StaticResource DBStructure_Label}">
									<DataGridTemplateColumn.CellEditingTemplate>
										<DataTemplate>
											<TextBox
												Text="{Binding Label, Mode=TwoWay}" />
										</DataTemplate>
									</DataGridTemplateColumn.CellEditingTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock
												Text="{Binding Label}" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTextColumn
									Header="{StaticResource DBStructure_Table}"
									IsReadOnly="True"
									Binding="{Binding Table}" />
								<DataGridTextColumn
									Header="{StaticResource DBStructure_Column}"
									IsReadOnly="True"
									Binding="{Binding Column}" />
								<DataGridTextColumn
									Header="{StaticResource DBStructure_WidgetType}"
									IsReadOnly="True"
									Binding="{Binding Widget}" />
								<DataGridTextColumn
									Header="{StaticResource DBStructure_WidgetLength}"
									Binding="{Binding Width}" />
							</DataGrid.Columns>
						</DataGrid>
					</Grid>
				</GroupBox>
				<GroupBox
					Header="{DynamicResource DBStructure_FieldLabelProperties}">
					<UniformGrid
						Columns="2"
						HorizontalAlignment="Left">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type UniformGrid}">
								<Style.Triggers>
									<DataTrigger
										Value="Tree"
										Binding="{Binding SelectedItem.Type, ElementName=ContainerListBox}">
										<Setter
											Property="IsEnabled"
											Value="False" />
									</DataTrigger>
									<DataTrigger
										Value="Table"
										Binding="{Binding SelectedItem.Type, ElementName=ContainerListBox}">
										<Setter
											Property="IsEnabled"
											Value="False" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
						<TextBlock
							Text="{StaticResource DBStructure_MaximumWidth}" />
						<TextBox
							Text="{Binding Container.MaximumWidthStrValue, ElementName=uiSelector}" />
						<TextBlock
							Text="{StaticResource DBStructure_NumberOfFields}" />
						<TextBox
							Text="{Binding Container.NumberOfFieldsStrValue, ElementName=uiSelector}" />
					</UniformGrid>
				</GroupBox>
				<GroupBox
					Header="{StaticResource DBStructure_ScrollRepeatHeader}">
					<UniformGrid
						Columns="2"
						HorizontalAlignment="Left">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type UniformGrid}">
								<Setter
									Property="IsEnabled"
									Value="False" />
								<Style.Triggers>
									<DataTrigger
										Value="ScrollGrid"
										Binding="{Binding SelectedItem.Type, ElementName=ContainerListBox}">
										<Setter
											Property="IsEnabled"
											Value="True" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
						<TextBlock
							Text="{StaticResource DBStructure_RepeatRowCount}" />
						<TextBox
							Text="{Binding Container.RepeatRowCountStrValue, ElementName=uiSelector, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock
							Text="{StaticResource DBStructure_RepeatColumnCount}" />
						<TextBox
							Text="{Binding Container.RepeatColumnCountStrValue, ElementName=uiSelector, UpdateSourceTrigger=PropertyChanged}" />
					</UniformGrid>
				</GroupBox>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
