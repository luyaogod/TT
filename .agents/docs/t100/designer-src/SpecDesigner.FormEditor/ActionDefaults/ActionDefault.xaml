<UserControl
	x:Class="SpecDesigner.FormEditor.ActionDefaults.ActionDefault"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
	xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
	xmlns:local="clr-namespace:SpecDesigner.FormEditor.ActionDefaults"
	xmlns:h="clr-namespace:SpecDesigner.SpecEditor.Helpers;assembly=SpecDesigner.SpecEditor"
	xmlns:cvm="clr-namespace:SpecDesignerCommon.ViewModel;assembly=SpecDesignerCommon"
	x:Name="adControl"
	Background="{DynamicResource ExpanderBackground}"
	ToolTip="{Binding Name}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<h:MatchSpecStatusConverter
				x:Key="MatchSpecStatusConverter" />
			<SolidColorBrush
				x:Key="BrushFFF6F6F2"
				Color="#FFF6F6F2" />
			<SolidColorBrush
				x:Key="BrushFF003C74"
				Color="#EBEBEB" />
			<SolidColorBrush
				x:Key="BrushBlack"
				Color="#FF000000" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<FrameworkElement.Style>
		<Style
			BasedOn="{StaticResource {x:Type UserControl}}"
			TargetType="{x:Type UserControl}">
			<Style.Triggers>
				<DataTrigger
					Value="True"
					Binding="{Binding Status, Converter='{StaticResource MatchSpecStatusConverter}', ConverterParameter='{x:Static cvm:SpecStatus.DELETE}'}">
					<Setter
						Property="Visibility"
						Value="Collapsed" />
				</DataTrigger>
				<DataTrigger
					Value="True"
					Binding="{Binding IsToolBarAction}">
					<Setter
						Property="Visibility"
						Value="Collapsed" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</FrameworkElement.Style>
	<Grid>
		<Border
			x:Name="actionBtn"
			BorderBrush="{StaticResource BrushFF003C74}"
			BorderThickness="1"
			CornerRadius="2"
			Background="{DynamicResource ExpanderBackground}"
			Margin="1">
			<Grid
				x:Name="btn"
				HorizontalAlignment="Stretch"
				Height="20"
				Margin="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>
				<ed:RegularPolygon
					x:Name="Regular"
					Visibility="Collapsed"
					Fill="{StaticResource BrushBlack}"
					Height="10"
					InnerRadius="1"
					PointCount="3"
					Margin="10 0"
					Stretch="Fill"
					Stroke="#FF000000"
					Width="10">
					<FrameworkElement.Style>
						<Style
							TargetType="{x:Type ed:RegularPolygon}">
							<Style.Triggers>
								<DataTrigger
									Value="0"
									Binding="{Binding ElementName=buttonContainer, Path=Children.Count}">
									<Setter
										Property="Visibility"
										Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
				</ed:RegularPolygon>
				<TextBlock
					Grid.Column="1"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Text="{Binding LocalString}" />
				<Grid
					x:Name="operationButtons"
					ColumnSpan="2"
					HorizontalAlignment="Right"
					Visibility="Collapsed">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Button
						x:Name="addButton"
						Content="+"
						Visibility="Collapsed"
						Command="local:ActionDefaultCommands.AddActionCommand"
						Grid.Column="0"
						CommandParameter="{Binding}" />
					<Button
						x:Name="removeButton"
						Grid.Column="1"
						Command="local:ActionDefaultCommands.DeleteActionCommand"
						Style="{DynamicResource DesignerFlatButton}"
						Padding="0,0,5,0"
						CommandParameter="{Binding}">
						<Image
							Source="pack://application:,,,/SpecDesigner.FormEditor;component/Images/action_delete.png"
							Height="9"
							Stretch="Uniform"
							VerticalAlignment="Center" />
					</Button>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>
