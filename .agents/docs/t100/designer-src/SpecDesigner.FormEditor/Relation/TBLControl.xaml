<UserControl
	x:Class="SpecDesigner.FormEditor.Relation.TBLControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:my="clr-namespace:SpecDesigner.FormEditor.Relation"
	xmlns:helper="clr-namespace:SpecDesigner.FormEditor.Helpers"
	xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	x:Name="usercontrol">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<helper:CheckedValueConverter
				x:Key="CheckedValueConverter" />
			<SolidColorBrush
				x:Key="ConnectionBrush"
				Color="#FF00EDFF" />
			<SolidColorBrush
				x:Key="ConnectionToChildBrush"
				Color="Blue" />
			<SolidColorBrush
				x:Key="ConnectionToParentBrush"
				Color="Red" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		x:Name="LayoutRoot">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Grid
			HorizontalAlignment="Center"
			MouseLeftButtonUp="Header_MouseLeftButtonUp">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Border
				x:Name="Header"
				BorderBrush="#FF000000"
				BorderThickness="2"
				Grid.RowSpan="2">
				<UIElement.Effect>
					<DropShadowEffect />
				</UIElement.Effect>
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Border}">
						<Setter
							Property="Background"
							Value="#FF1E90FF" />
						<Style.Triggers>
							<DataTrigger
								Value="{x:Static sys:String.Empty}"
								Binding="{Binding UpperTable}">
								<Setter
									Property="Background"
									Value="#FFFFFFFF" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
			</Border>
			<Border
				BorderBrush="#FF000000"
				Grid.Row="0"
				BorderThickness="0,0,0,1"
				Margin="2,2,2,0">
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Border}">
						<Setter
							Property="Background"
							Value="#FFffa800" />
						<Style.Triggers>
							<DataTrigger
								Value="Y"
								Binding="{Binding Main}">
								<Setter
									Property="Background"
									Value="#FFFF9D9D" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
				<Grid>
					<StackPanel>
						<TextBlock
							x:Name="TBLNameTextBlock"
							Margin="10,2,10,0"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Text="{Binding TBLName}" />
						<TextBlock
							Margin="10,0,10,2"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Text="{Binding TBLText}" />
					</StackPanel>
				</Grid>
			</Border>
			<Border
				Grid.RowSpan="2"
				BorderBrush="#FF00EDFF"
				BorderThickness="4"
				Margin="-2">
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Border}">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger
								Value="True"
								Binding="{Binding Path=IsSelected, ElementName=usercontrol}">
								<Setter
									Property="Visibility"
									Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
				<Grid>
					<ed:BlockArrow
						x:Name="ConnToChildArrow"
						Fill="{StaticResource ConnectionToChildBrush}"
						Stroke="{StaticResource ConnectionBrush}"
						Width="16"
						Height="24"
						HorizontalAlignment="Center"
						VerticalAlignment="Bottom"
						Orientation="Down"
						Margin="0,0,0,-24" />
					<ed:BlockArrow
						x:Name="ConnToParentArrow"
						Fill="{StaticResource ConnectionToParentBrush}"
						Stroke="{StaticResource ConnectionBrush}"
						Width="16"
						Height="24"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Orientation="Up"
						Margin="0,-24,0,0">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type ed:BlockArrow}">
								<Style.Triggers>
									<DataTrigger
										Value="Y"
										Binding="{Binding Main}">
										<Setter
											Property="Visibility"
											Value="Collapsed" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</ed:BlockArrow>
					<Image
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Margin="0,0,-21,0"
						Cursor="Hand"
						Source="../Images/modify_tbl.png"
						Width="16"
						Height="16"
						ToolTip="{StaticResource Items_Modify}"
						MouseLeftButtonDown="ModifyImg_Click" />
					<Image
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Margin="0,20,-21,0"
						Cursor="Hand"
						Source="../Images/del_tbl.png"
						Width="16"
						Height="16"
						ToolTip="{StaticResource Items_Delete}"
						MouseLeftButtonDown="DeleteImg_Click">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Image}">
								<Style.Triggers>
									<DataTrigger
										Value="Y"
										Binding="{Binding Main}">
										<Setter
											Property="Visibility"
											Value="Collapsed" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Image>
					<Image
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Margin="0,40,-21,0"
						Cursor="Hand"
						Source="../Images/add_tbl.png"
						Width="16"
						Height="16"
						ToolTip="{StaticResource Items_Add}"
						MouseLeftButtonDown="AddChildTBLImg_Click" />
				</Grid>
			</Border>
			<ItemsControl
				Grid.Row="1"
				Margin="5"
				HorizontalAlignment="Center"
				ItemsSource="{Binding ScreenRecords}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid
							HorizontalAlignment="Center"
							Margin="10,0,10,0">
							<FrameworkElement.ContextMenu>
								<ContextMenu>
									<MenuItem
										IsCheckable="True"
										Header="{StaticResource menu_Cascade}"
										IsChecked="{Binding Cascade, Converter='{StaticResource CheckedValueConverter}'}" />
									<MenuItem
										Header="Delete"
										Command="my:RelationshipCommands.DeleteTBLControlCommand"
										CommandParameter="{Binding SRName}" />
								</ContextMenu>
							</FrameworkElement.ContextMenu>
							<Ellipse>
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type Ellipse}">
										<Setter
											Property="Stroke"
											Value="#FF000000" />
										<Setter
											Property="Fill"
											Value="#FFFFFFFF" />
										<Style.Triggers>
											<DataTrigger
												Value="Y"
												Binding="{Binding Cascade}">
												<Setter
													Property="Fill"
													Value="#FFfff4a3" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
							</Ellipse>
							<StackPanel
								Orientation="Horizontal"
								Margin="10">
								<Image
									VerticalAlignment="Center"
									Width="16"
									Height="16"
									Source="../Images/screenRecord.png"
									Margin="10 0 0 0" />
								<TextBlock
									Margin="2 0 0 0"
									VerticalAlignment="Center"
									Text="{Binding SRName}" />
							</StackPanel>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel
							Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</Grid>
		<StackPanel
			x:Name="ChildrenContainer"
			Grid.Row="1"
			Margin="5 50 5 0"
			HorizontalAlignment="Center"
			Orientation="Horizontal">
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<Style
						x:Key="{x:Type my:TBLControl}"
						TargetType="{x:Type my:TBLControl}">
						<Setter
							Property="Margin"
							Value="10,0,10,0" />
					</Style>
				</ResourceDictionary>
			</FrameworkElement.Resources>
		</StackPanel>
	</Grid>
</UserControl>
