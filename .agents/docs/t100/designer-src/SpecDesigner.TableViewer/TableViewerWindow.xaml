<Window
	x:Class="SpecDesigner.TableViewer.TableViewerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:h="clr-namespace:SpecDesigner.TableViewer.Helper"
	xmlns:l="clr-namespace:SpecDesigner.TableViewer">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<h:BooleanConverter
				x:Key="booleanConverter" />
			<h:DataTypeConverter
				x:Key="dataTypeConverter" />
			<ContextMenu
				x:Key="TableContextMenu">
				<MenuItem
					Command="l:TableColumnCommands.CopyAllColumnsToRecordCommand"
					Header="{StaticResource columnView_CopyAllColumnsToRecord}"
					CommandParameter="{Binding Attribute[name].Value, Mode=OneWay}" />
				<MenuItem
					Command="l:TableColumnCommands.CopyAllColumnsNameCommand"
					Header="{StaticResource columnView_CopyColumnsName}"
					CommandParameter="{Binding Attribute[name].Value, Mode=OneWay}" />
			</ContextMenu>
			<ContextMenu
				x:Key="ColumnContextMenu">
				<MenuItem
					Command="l:TableColumnCommands.CopyContentCommand"
					Header="{StaticResource columnView_CopyName}"
					CommandParameter="{Binding Attribute[name].Value, Mode=OneWay}" />
			</ContextMenu>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="5">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="45*" />
			<ColumnDefinition
				Width="55*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid
			ColumnSpan="2"
			VerticalAlignment="Top"
			Margin="0 0 0 5">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<Label
				Content="{StaticResource tableView_ModuleTitle}" />
			<ComboBox
				x:Name="moduleCombo"
				Grid.Row="0"
				Grid.Column="1"
				Grid.ColumnSpan="2"
				IsEditable="True"
				Width="150"
				HorizontalAlignment="Left"
				ItemsSource="{Binding}" />
			<Label
				Content="{StaticResource tableView_SearchTitle}"
				Grid.Row="1"
				Grid.Column="0" />
			<TextBox
				x:Name="searchBox"
				Grid.Row="1"
				Grid.Column="1"
				Width="150"
				HorizontalAlignment="Left" />
			<Button
				Content="Go"
				Grid.Row="1"
				Grid.Column="2"
				Margin="5 0 5 0"
				HorizontalAlignment="Left"
				Width="50"
				Visibility="Collapsed"
				Click="Button_Click" />
		</Grid>
		<DataGrid
			x:Name="tableView"
			Grid.Row="2"
			Margin="0 0 5 0"
			ItemsSource="{Binding}">
			<DataGrid.Columns>
				<DataGridTextColumn
					Header="{StaticResource tableView_TableModule}"
					IsReadOnly="True"
					Binding="{Binding Path=Attribute[module].Value}" />
				<DataGridTextColumn
					Header="{StaticResource tableView_TableName}"
					IsReadOnly="True"
					Binding="{Binding Path=Attribute[name].Value}">
					<DataGridColumn.CellStyle>
						<Style
							TargetType="{x:Type DataGridCell}">
							<Setter
								Property="FrameworkElement.ContextMenu"
								Value="{StaticResource TableContextMenu}" />
						</Style>
					</DataGridColumn.CellStyle>
				</DataGridTextColumn>
				<DataGridTextColumn
					Header="{StaticResource tableView_TableDesc}"
					IsReadOnly="True"
					Binding="{Binding Path=Attribute[desc].Value}" />
				<DataGridTextColumn
					Header="{StaticResource tableView_TableType}"
					IsReadOnly="True"
					Binding="{Binding Path=Attribute[type].Value}" />
			</DataGrid.Columns>
		</DataGrid>
		<GridSplitter
			Width="5"
			Grid.Row="2" />
		<Grid
			Column="1"
			Row="2">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>
			<TextBlock
				x:Name="tableLabel"
				Visibility="Collapsed" />
			<DataGrid
				x:Name="columnView"
				Grid.Row="1"
				ItemsSource="{Binding Elements[column]}">
				<DataGrid.Columns>
					<DataGridTextColumn
						Header="{StaticResource tableView_ColumnName}"
						IsReadOnly="True"
						Binding="{Binding Path=Attribute[name].Value}">
						<DataGridColumn.CellStyle>
							<Style
								TargetType="{x:Type DataGridCell}">
								<Setter
									Property="FrameworkElement.ContextMenu"
									Value="{StaticResource ColumnContextMenu}" />
							</Style>
						</DataGridColumn.CellStyle>
					</DataGridTextColumn>
					<DataGridTextColumn
						Header="{StaticResource tableView_ColumnText}"
						IsReadOnly="True"
						Binding="{Binding Path=Attribute[text].Value}" />
					<DataGridTemplateColumn
						Header="{StaticResource tableView_ColumnPK}"
						IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox
									HorizontalAlignment="Center"
									IsEnabled="False"
									IsChecked="{Binding Path=Attribute[pk].Value, Converter='{StaticResource booleanConverter}'}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn
						Header="{StaticResource tableView_ColumnReq}"
						IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox
									IsEnabled="False"
									HorizontalAlignment="Center"
									IsChecked="{Binding Path=Attribute[req].Value, Converter='{StaticResource booleanConverter}'}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTextColumn
						Header="{StaticResource tableView_ColumnAttr}"
						IsReadOnly="True"
						Binding="{Binding Path=Attribute[attribute].Value}" />
					<DataGridTextColumn
						Header="{StaticResource tableView_ColumnAttrName}"
						IsReadOnly="True"
						Binding="{Binding Path=Attribute[attribute].Value, Converter='{StaticResource dataTypeConverter}'}" />
					<DataGridTextColumn
						Header="{StaticResource tableView_ColumnType}"
						IsReadOnly="True"
						Binding="{Binding Path=Attribute[type].Value}" />
				</DataGrid.Columns>
			</DataGrid>
		</Grid>
		<StatusBar
			Grid.Row="3"
			Grid.ColumnSpan="2">
			<StatusBarItem
				x:Name="statusItem" />
		</StatusBar>
	</Grid>
</Window>
