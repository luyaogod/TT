<UserControl
	x:Class="SpecDesigner.FormEditor.Views.DatabaseSourceViewer"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
	xmlns:vm="clr-namespace:SpecDesignerCommon.ViewModel;assembly=SpecDesignerCommon"
	xmlns:b="clr-namespace:SpecDesigner.FormEditor.Behaviors"
	xmlns:views="clr-namespace:SpecDesigner.FormEditor.Views">
	<Grid>
		<TreeView
			Name="DatabaseSourceTree"
			ItemsSource="{Binding Source='{x:Static vm:DatabaseSourceViewModel.This}', Path=DatabaseSource.Tables}">
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<HierarchicalDataTemplate
						x:Key="{DataTemplateKey {x:Type vm:DSTableModel}}"
						DataType="{x:Type vm:DSTableModel}"
						ItemsSource="{Binding Columns}">
						<StackPanel
							Orientation="Horizontal">
							<Image
								Source="/SpecDesigner.FormEditor;component/Images/table.png"
								Width="16"
								Height="16" />
							<TextBlock
								Margin="5 2 0 2"
								Text="{Binding Table.TBLName}" />
							<TextBlock
								Text=" (" />
							<TextBlock
								Text="{Binding Table.TBLText}" />
							<TextBlock
								Text=")" />
						</StackPanel>
					</HierarchicalDataTemplate>
					<DataTemplate
						x:Key="{DataTemplateKey {x:Type vm:DSColumnViewModel}}"
						DataType="{x:Type vm:DSColumnViewModel}">
						<FrameworkTemplate.Resources>
							<ResourceDictionary>
								<Style
									x:Key="{x:Type StackPanel}"
									TargetType="{x:Type StackPanel}">
									<Style.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding IsUsed}">
											<Setter
												Property="Background"
												Value="#8FBC8B" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</ResourceDictionary>
						</FrameworkTemplate.Resources>
						<StackPanel
							Orientation="Horizontal">
							<Image
								Source="/SpecDesigner.FormEditor;component/Images/variable_local.png"
								Width="16"
								Height="16" />
							<TextBlock
								Margin="5 2 0 2"
								Text="{Binding Name}" />
							<TextBlock
								Text=" (" />
							<TextBlock
								Text="{Binding Description}" />
							<TextBlock
								Text=")" />
							<i:Interaction.Behaviors>
								<b:DatabaseSourceDragBehavior />
							</i:Interaction.Behaviors>
						</StackPanel>
					</DataTemplate>
				</ResourceDictionary>
			</FrameworkElement.Resources>
		</TreeView>
	</Grid>
</UserControl>
