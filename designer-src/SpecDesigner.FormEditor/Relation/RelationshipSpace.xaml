<UserControl
	x:Class="SpecDesigner.FormEditor.Relation.RelationshipSpace"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:my="clr-namespace:SpecDesigner.FormEditor.Relation"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:me="clr-namespace:SpecDesigner.FormEditor.Relation"
	x:Name="space">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<SolidColorBrush
				x:Key="ConnectionBrush"
				Color="#FF00EDFF" />
			<SolidColorBrush
				x:Key="ConnectionToChildBrush"
				Color="Blue" />
			<SolidColorBrush
				x:Key="ConnectionToParentBrush"
				Color="Red" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<ScrollViewer
			HorizontalScrollBarVisibility="Auto"
			VerticalScrollBarVisibility="Auto">
			<Grid
				x:Name="LayoutRoot"
				Margin="5 20 5 0"
				Background="#FFFFFFFF">
				<FrameworkElement.ContextMenu>
					<ContextMenu>
						<MenuItem
							Header="{StaticResource menu_CreateNewTBL}"
							Click="CreateNewTBLMenuItem_Click" />
					</ContextMenu>
				</FrameworkElement.ContextMenu>
				<StackPanel
					x:Name="Container"
					Orientation="Horizontal">
					<FrameworkElement.Resources>
						<ResourceDictionary>
							<Style
								x:Key="{x:Type my:TBLControl}"
								TargetType="{x:Type my:TBLControl}">
								<Setter
									Property="Margin"
									Value="10,0,10,0" />
							</Style>
						</ResourceDictionary>
					</FrameworkElement.Resources>
				</StackPanel>
			</Grid>
		</ScrollViewer>
		<Canvas
			x:Name="Canvas1"
			Visibility="Collapsed"
			Background="#AACCCCCC"
			MouseMove="Canvas1_MouseMove"
			MouseUp="Canvas1_MouseLeftButtonUp"
			MouseLeftButtonDown="Canvas1_MouseLeftButtonDown">
			<Grid
				x:Name="ModifyTBLBox"
				Visibility="Collapsed"
				Background="#AACCCCCC">
				<Border
					BorderThickness="3"
					Background="#FFFFFFFF"
					BorderBrush="#FF0000FF"
					CornerRadius="2"
					VerticalAlignment="Center"
					HorizontalAlignment="Center"
					Grid.Row="1">
					<StackPanel
						MaxWidth="300">
						<TextBlock
							Text="{StaticResource Message_ChageTableRelation}"
							Foreground="#FFFF0000"
							TextWrapping="Wrap"
							Margin="10,5,10,5"
							FontWeight="Bold" />
						<GroupBox
							Header="PK/FK設定"
							Margin="5"
							Width="300"
							Background="#FFFFFFFF">
							<UniformGrid
								Margin="4"
								Columns="2">
								<TextBlock
									Text="Table:" />
								<ComboBox
									x:Name="newTBLName"
									VirtualizingStackPanel.IsVirtualizing="True"
									ItemsSource="{Binding Path=Tables, ElementName=space}"
									SelectedValue="{Binding TBLName, Mode=TwoWay}">
									<FrameworkElement.Style>
										<Style
											BasedOn="{StaticResource {x:Type ComboBox}}"
											TargetType="{x:Type ComboBox}">
											<Setter
												Property="IsEnabled"
												Value="True" />
											<Style.Triggers>
												<DataTrigger
													Value="Y"
													Binding="{Binding Main}">
													<Setter
														Property="IsEnabled"
														Value="False" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</FrameworkElement.Style>
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<VirtualizingStackPanel />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemContainerStyle>
										<Style
											BasedOn="{StaticResource {x:Type ComboBoxItem}}"
											TargetType="{x:Type ComboBoxItem}">
											<Setter
												Property="IsEnabled"
												Value="{Binding IsEnabled}" />
											<Style.Triggers>
												<DataTrigger
													Value="False"
													Binding="{Binding IsEnabled}">
													<Setter
														Property="UIElement.Opacity"
														Value="0.5" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</ItemsControl.ItemContainerStyle>
								</ComboBox>
								<TextBlock
									Text="Table名稱" />
								<TextBox
									IsReadOnly="True"
									Text="{Binding TBLDesc, Mode=OneWay}" />
								<TextBlock
									Text="{StaticResource PK}" />
								<TextBox
									x:Name="modifyPkTB"
									Text="{Binding PK}" />
								<TextBlock
									Text="{StaticResource FK_table}" />
								<TextBox
									x:Name="FKtableTB"
									IsReadOnly="True"
									Text="{Binding Parent, Mode=OneWay}" />
								<TextBlock
									Text="{StaticResource FkMaster}" />
								<TextBox
									x:Name="modifyFkmTB"
									Text="{Binding FkMaster, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" />
								<TextBlock
									Text="{StaticResource FkDetail}" />
								<TextBox
									x:Name="modifyFkdTB"
									Text="{Binding FkDetail, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" />
							</UniformGrid>
						</GroupBox>
						<GroupBox
							Header="{StaticResource tableRlation_layerDisplay}"
							Margin="5"
							Width="300"
							Background="#FFFFFFFF">
							<UniformGrid
								Margin="4"
								Columns="2">
								<TextBlock
									Text="{StaticResource tableRlation_upperTable}" />
								<ComboBox
									x:Name="modifyUpperTBLNameCB"
									ItemsSource="{Binding Path=UpperTables, ElementName=space}"
									SelectedValue="{Binding UpperTable}"
									SelectionChanged="modifyUpperTBLNameCB_SelectionChanged">
									<FrameworkElement.Style>
										<Style
											BasedOn="{StaticResource {x:Type ComboBox}}"
											TargetType="{x:Type ComboBox}">
											<Setter
												Property="IsEnabled"
												Value="True" />
											<Style.Triggers>
												<DataTrigger
													Value="Y"
													Binding="{Binding Main}">
													<Setter
														Property="IsEnabled"
														Value="False" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</FrameworkElement.Style>
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<VirtualizingStackPanel />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemContainerStyle>
										<Style
											BasedOn="{StaticResource {x:Type ComboBoxItem}}"
											TargetType="{x:Type ComboBoxItem}">
											<Setter
												Property="IsEnabled"
												Value="{Binding IsEnabled}" />
										</Style>
									</ItemsControl.ItemContainerStyle>
								</ComboBox>
								<TextBlock
									Text="Table名稱" />
								<TextBox
									IsReadOnly="True"
									Text="{Binding UpperTableDesc, Mode=OneWay}" />
								<TextBlock
									Text="{StaticResource tableRlation_upperKey}" />
								<TextBox
									x:Name="modifyUpperKeyTB"
									Text="{Binding UpperKey}">
									<FrameworkElement.Style>
										<Style
											BasedOn="{StaticResource {x:Type TextBox}}"
											TargetType="{x:Type TextBox}">
											<Setter
												Property="IsEnabled"
												Value="True" />
											<Style.Triggers>
												<DataTrigger
													Value="{x:Static sys:String.Empty}"
													Binding="{Binding UpperTable, Mode=OneWay}">
													<Setter
														Property="IsEnabled"
														Value="False" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</FrameworkElement.Style>
								</TextBox>
								<TextBlock
									Text="{StaticResource tableRlation_thisKey}" />
								<TextBox
									x:Name="modifyThisKeyTB"
									Text="{Binding ThisKey}">
									<FrameworkElement.Style>
										<Style
											BasedOn="{StaticResource {x:Type TextBox}}"
											TargetType="{x:Type TextBox}">
											<Setter
												Property="IsEnabled"
												Value="True" />
											<Style.Triggers>
												<DataTrigger
													Value="{x:Static sys:String.Empty}"
													Binding="{Binding UpperTable, Mode=OneWay}">
													<Setter
														Property="IsEnabled"
														Value="False" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</FrameworkElement.Style>
								</TextBox>
							</UniformGrid>
						</GroupBox>
						<UniformGrid>
							<Button
								Content="{StaticResource Button_OK}"
								HorizontalAlignment="Center"
								Margin="4,0"
								MinWidth="70"
								Command="{Binding ConfirmCommand, ElementName=space}" />
							<Button
								Content="{StaticResource Button_Cancel}"
								HorizontalAlignment="Center"
								Margin="4,0"
								MinWidth="70"
								Click="CancelTBLBox_MouseLeftButtonUp" />
						</UniformGrid>
					</StackPanel>
				</Border>
			</Grid>
			<Grid
				x:Name="CreateTBLBox"
				Visibility="Collapsed"
				Background="#AACCCCCC">
				<Border
					BorderThickness="3"
					Background="#FFFFFFFF"
					BorderBrush="#FF0000FF"
					CornerRadius="2"
					VerticalAlignment="Center"
					HorizontalAlignment="Center">
					<GroupBox
						Header="建立新Table Schema"
						Margin="5"
						Width="250"
						Background="#FFFFFFFF">
						<UniformGrid
							Margin="4"
							Columns="2">
							<TextBlock
								Text="Table代號 :" />
							<ComboBox
								x:Name="modifyTBLNameCB"
								VirtualizingStackPanel.IsVirtualizing="True"
								ItemsSource="{Binding Path=Tables, ElementName=space}"
								SelectedValue="{Binding TBLName, Mode=TwoWay}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<VirtualizingStackPanel />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemContainerStyle>
									<Style
										BasedOn="{StaticResource {x:Type ComboBoxItem}}"
										TargetType="{x:Type ComboBoxItem}">
										<Setter
											Property="IsEnabled"
											Value="{Binding IsEnabled}" />
										<Style.Triggers>
											<DataTrigger
												Value="False"
												Binding="{Binding IsEnabled}">
												<Setter
													Property="UIElement.Opacity"
													Value="0.5" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</ItemsControl.ItemContainerStyle>
							</ComboBox>
							<TextBlock
								Text="Table名稱" />
							<TextBox
								IsReadOnly="True"
								Text="{Binding TBLDesc, Mode=OneWay}" />
							<TextBlock />
							<TextBlock />
							<Button
								x:Name="AcceptNewTBLButton"
								HorizontalAlignment="Center"
								Margin="4,0"
								MinWidth="70"
								Content="{StaticResource Button_OK}"
								Click="AcceptNewTBLButton_Click" />
							<Button
								Content="{StaticResource Button_Cancel}"
								HorizontalAlignment="Center"
								Margin="4,0"
								MinWidth="70"
								Click="CancelNewTBLButton_Click" />
						</UniformGrid>
					</GroupBox>
				</Border>
			</Grid>
		</Canvas>
	</Grid>
</UserControl>
