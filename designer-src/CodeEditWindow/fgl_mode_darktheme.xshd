<?xml version="1.0"?>
<SyntaxDefinition name="FGL" extensions=".4gl" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<!-- The named colors 'Comment' and 'String' are used in SharpDevelop to detect if a line is inside a multiline string/comment -->
	<Color name="Comment" foreground="#00DB00" exampleText="# comment" />
  <Color name="Preprocessor" foreground="#00DB00" exampleText="#region Title" />
  <Color name="Tag" foreground="#8AC6F2" fontWeight="bold" background="Pink" exampleText="{...}" />
  <Color name="Keywords" foreground="#8AC6F2" fontWeight="bold" exampleText="if (a) {} else {}"/>
	<Color name="String" foreground="#008A7C" exampleText="string text = &quot;Hello, World!&quot;"/>
	<Color name="Char" foreground="#008A7C" exampleText="char linefeed = '\n';"/>
	<Color name="NumberLiteral" foreground="#008A7C" exampleText="3.1415f"/>
  <Color name="Delimiters" foreground="#FF00FF" fontWeight="bold"/>
  <Color name="MethodCall" foreground="#6100BE" fontWeight="bold" exampleText="o.ToString();"/>

  <RuleSet name="CommentMarkerSet"/>
	
	<!-- This is the main ruleset. -->
	<RuleSet ignoreCase="true">
    <Span color="Comment" ruleSet="CommentMarkerSet">
      <Begin>\#</Begin>
    </Span>
    
    <Span color="Comment" ruleSet="CommentMarkerSet">
      <Begin>--</Begin>
    </Span>

    <Span color="Tag" ruleSet="CommentMarkerSet" multiline="true">
      <Begin>{</Begin>
      <End>}</End>
    </Span>

    <Span color="String" multiline="true">
			<Begin>"</Begin>
			<End>"</End>
			<RuleSet>
				<!-- span for escape sequences -->
				<Span begin="\\" end="."/>
			</RuleSet>
		</Span>
		
		<Span color="Char" multiline="true">
			<Begin>'</Begin>
			<End>'</End>
			<RuleSet>
				<!-- span for escape sequences -->
				<Span begin="\\" end="."/>
			</RuleSet>
		</Span>		
		
		<!-- don't highlight "@int" as keyword -->
		<Rule>
			@[\w\d_]+
		</Rule>		
		
