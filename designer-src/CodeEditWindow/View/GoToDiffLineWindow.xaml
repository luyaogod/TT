<Window
	x:Class="SpecDesigner.CodeEditWindow.View.GoToDiffLineWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:v="clr-namespace:SpecDesigner.CodeEditWindow.View"
	x:Name="This"
	ResizeMode="NoResize"
	SizeToContent="Height"
	WindowStartupLocation="CenterScreen"
	ShowInTaskbar="False"
	Width="200"
	Title="Go To Diff Line">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock
			x:Name="titleTextBlock"
			Margin="4" />
		<TextBox
			x:Name="lineTextBox"
			Grid.Row="1"
			Style="{StaticResource TextBoxErrorStyle}"
			Margin="20 4 20 4"
			Text="{Binding LineOnCaret, ElementName=This}" />
		<Grid
			Row="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Button
				Content="{StaticResource Button_OK}"
				Margin="8"
				Click="OKButton_Click" />
			<Button
				Content="{StaticResource Button_Cancel}"
				Grid.Column="1"
				Margin="8"
				Click="CancelButton_Click" />
		</Grid>
	</Grid>
</Window>
