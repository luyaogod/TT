<Window
	x:Class="SpecDesigner.CodeEditWindow.View.SearchKeySettingWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:lc="clr-namespace:SpecDesigner.Controls.Controls;assembly=SpecDesigner.Controls"
	ShowInTaskbar="False"
	Width="300"
	Height="150"
	Title="SearchKeySetting"
	xmlns:view="clr-namespace:SpecDesigner.CodeEditWindow.View">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<StackPanel
			Grid.Row="0">
			<TextBlock
				Text="{StaticResource menu_FindTarget}" />
			<lc:AutoFilteredComboBox
				x:Name="SearchCB"
				IsCaseSensitive="False"
				IsEditable="True"
				StaysOpenOnEdit="False"
				IsTextSearchCaseSensitive="True"
				IsTextSearchEnabled="True"
				ItemsSource="{Binding SearchHistory}" />
			<TextBlock
				Text="{StaticResource menu_FindRange}" />
			<ComboBox
				x:Name="SearchTargetCB"
				IsEditable="True"
				SelectedIndex="0">
				<ComboBoxItem
					Tag="Current Document"
					Content="{StaticResource Search_CurrentDocument}" />
				<ComboBoxItem
					Tag="All Open Documents"
					Content="{StaticResource Search_AllOpenDocument}" />
			</ComboBox>
		</StackPanel>
		<UniformGrid
			HorizontalAlignment="Right"
			Grid.Row="1">
			<Button
				Content="{StaticResource Search_BeginSearch}"
				Grid.Column="1"
				Margin="4,0"
				MinWidth="70"
				Height="20"
				Click="Button_Click" />
		</UniformGrid>
	</Grid>
</Window>
