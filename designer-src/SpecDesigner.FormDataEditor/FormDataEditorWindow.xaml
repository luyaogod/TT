<Window
	x:Class="SpecDesigner.FormDataEditor.FormDataEditorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:SpecDesigner.FormDataEditor"
	Style="{DynamicResource WindowStyle}"
	Height="350"
	Width="525">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				x:Key="{x:Type Button}"
				x:Name="button"
				TargetType="{x:Type Button}">
				<Setter
					Property="Margin"
					Value="10 5 10 5" />
				<Setter
					Property="HorizontalContentAlignment"
					Value="Center" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UniformGrid
		Columns="2">
		<StackPanel>
			<Button
				Content="資料項目"
				Click="Button_Click" />
			<Button
				Content="校驗帶值" />
			<Button
				Content="提示訊息" />
			<Button
				Content="開窗設計" />
		</StackPanel>
		<StackPanel />
	</UniformGrid>
</Window>
