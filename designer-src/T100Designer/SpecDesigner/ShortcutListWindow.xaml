<Window
	x:Class="SpecDesigner.ShortcutListWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Name="Window"
	Title="{StaticResource Key_HotkeyList}"
	WindowStyle="SingleBorderWindow"
	ResizeMode="NoResize"
	SizeToContent="WidthAndHeight"
	WindowStartupLocation="CenterOwner"
	xmlns:specdesigner="clr-namespace:SpecDesigner">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				x:Key="{x:Type TextBlock}"
				TargetType="{x:Type TextBlock}"
				BasedOn="{StaticResource {x:Type TextBlock}}">
				<Setter
					Property="Margin"
					Value="0 4" />
				<Setter
					Property="Foreground"
					Value="#FF000000" />
			</Style>
			<Style
				x:Key="{x:Type GroupBox}"
				TargetType="{x:Type GroupBox}"
				BasedOn="{StaticResource {x:Type GroupBox}}">
				<Setter
					Property="Margin"
					Value="5" />
				<Setter
					Property="Foreground"
					Value="#FF0000FF" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<StackPanel
		x:Name="LayoutRoot"
		Orientation="Horizontal">
		<GroupBox
			Header="T100Designer:">
			<StackPanel
				Margin="5">
				<TextBlock
					Text="{StaticResource Key_OpenFile}" />
				<TextBlock
					Text="{StaticResource Key_SaveFile}" />
				<TextBlock
					Text="{StaticResource Key_CloseFile}" />
				<TextBlock
					Text="{StaticResource Key_Upload}" />
				<TextBlock
					Text="{StaticResource Key_Precompile}" />
				<TextBlock
					Text="{StaticResource Key_Exit}" />
				<TextBlock
					Text="{StaticResource Key_ExportSpec}" />
				<TextBlock
					Text="{StaticResource Key_Search}" />
				<TextBlock
					Text="{StaticResource Key_Replace}" />
				<TextBlock
					Text="{StaticResource Key_About}" />
			</StackPanel>
		</GroupBox>
		<GroupBox
			Header="Form Designer:">
			<StackPanel
				Margin="5">
				<TextBlock
					Text="{StaticResource Key_CutComponet}" />
				<TextBlock
					Text="{StaticResource Key_PasteComponet}" />
				<TextBlock
					Text="{StaticResource Key_MultiSelectComponetsInRegion}" />
				<TextBlock
					Text="{StaticResource Key_MultiSelectComponets}" />
			</StackPanel>
		</GroupBox>
		<GroupBox
			Header="Code Editor:">
			<StackPanel
				Margin="5">
				<TextBlock
					Text="{StaticResource Key_Cut}" />
				<TextBlock
					Text="{StaticResource Key_Paste}" />
				<TextBlock
					Text="{StaticResource Key_MarkSelectedArea}" />
				<TextBlock
					Text="{StaticResource Key_UnmarkSelectedArea}" />
				<TextBlock
					Text="{StaticResource Key_RefreshScreens}" />
				<TextBlock
					Text="{StaticResource Key_ChangeGeneroKeywordsToUppercase}" />
				<TextBlock
					Text="{StaticResource Key_TermAssistance}" />
				<TextBlock
					Text="{StaticResource Key_CheckFunctions}" />
				<TextBlock
					Text="{StaticResource Key_GoToAssignedLineNo}" />
				<TextBlock
					Text="{StaticResource Key_DisplaySelfbuildKeywordList}" />
				<TextBlock
					Text="{StaticResource Key_DisplayDBColumnsList}" />
				<TextBlock
					Text="{StaticResource Key_DiffRefersh}" />
				<TextBlock
					Text="{StaticResource Key_BlockMoveLeft}" />
				<TextBlock
					Text="{StaticResource Key_BlockMoveRight}" />
			</StackPanel>
		</GroupBox>
	</StackPanel>
</Window>
