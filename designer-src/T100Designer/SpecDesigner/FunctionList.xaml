<UserControl
	x:Class="SpecDesigner.FunctionList"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:ch="clr-namespace:SpecDesigner.Controls.Controls;assembly=SpecDesigner.Controls"
	xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
	xmlns:helper="clr-namespace:SpecDesigner.Controls.Controls.Helpers;assembly=SpecDesigner.Controls"
	xmlns:l="clr-namespace:SpecDesigner">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				x:Key="{x:Type ListViewItem}"
				TargetType="{x:Type ListViewItem}">
				<Style.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							x:Key="{x:Static SystemColors.HighlightBrushKey}"
							Color="#FFB8B8B8" />
						<SolidColorBrush
							x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
							Color="Blue" />
					</ResourceDictionary>
				</Style.Resources>
			</Style>
			<Style
				x:Key="buttonImageStyle"
				TargetType="{x:Type Image}">
				<Setter
					Property="Height"
					Value="24" />
				<Setter
					Property="Width"
					Value="24" />
				<Setter
					Property="Stretch"
					Value="Uniform" />
			</Style>
			<Style
				x:Key="{x:Type ToggleButton}"
				TargetType="{x:Type ToggleButton}">
				<Setter
					Property="Margin"
					Value="0,0,2,0" />
				<Setter
					Property="Focusable"
					Value="False" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ToggleButton}">
							<Grid
								Width="15"
								Background="#00FFFFFF">
								<Path
									x:Name="Mark"
									Data="M139.273,49.088 C139.273,45.804 136.523,43.139 133.127,43.139 C132.90800000000002,43.139 132.693,43.151 132.48100000000002,43.17 L90.03600000000003,42.169000000000004 L75.53600000000003,4.315000000000005 C74.805,1.824 72.443,0 69.637,0 C66.828,0 64.469,1.824 63.735,4.315 L49.232,42.169 L6.789,43.17 C6.576,43.149 6.359,43.139 6.143,43.139 C2.75,43.136 0,45.802 0,49.088 C0,51.188 1.121,53.026 2.812,54.085 L36.619,77.985 L24.555999999999997,115.479 C24.118,116.292 23.868,117.22 23.868,118.202 C23.868,121.489 26.618,124.154 30.014,124.154 C31.452,124.154 32.78,123.67 33.826,122.86399999999999 L69.64,100.127 L105.452,122.86399999999999 C106.501,123.66999999999999 107.823,124.154 109.264,124.154 C112.657,124.154 115.407,121.48899999999999 115.407,118.202 C115.407,117.223 115.157,116.29599999999999 114.719,115.479 L102.657,77.985 L136.463,54.085 C138.15,53.024 139.273,51.185 139.273,49.088"
									Stretch="Uniform"
									Stroke="#FF808080">
									<FrameworkElement.Style>
										<Style
											TargetType="{x:Type Path}">
											<Setter
												Property="Visibility"
												Value="Visible" />
											<Style.Triggers>
												<DataTrigger
													Value="True"
													Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}">
													<Setter
														Property="Fill"
														Value="#FFFF0000" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</FrameworkElement.Style>
								</Path>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<TextBox
			x:Name="searchBox"
			ch:TextBoxHelper.Watermark="Search"
			ch:TextBoxHelper.ButtonMode="Search"
			ch:TextBoxHelper.ButtonCommand="l:FunctionListCommands.SearchCommand"
			ch:TextBoxHelper.ButtonCommandParameter="{Binding Path=Text, ElementName=searchBox, UpdateSourceTrigger=PropertyChanged}"
			TextChanged="TextBox_TextChanged" />
		<Grid
			Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBox
				x:Name="createBox"
				ch:TextBoxHelper.Watermark="Create new word (ex: cl_init())"
				AcceptsReturn="True" />
			<Button
				Grid.Column="1"
				Command="l:FunctionListCommands.AddCommand">
				<Image
					Source="pack://application:,,,/SpecDesigner.SpecEditor;component/Images/item_add.png"
					Width="10"
					HorizontalAlignment="Center" />
			</Button>
		</Grid>
		<ListView
			x:Name="contentList"
			Grid.Row="2"
			HorizontalContentAlignment="Stretch"
			ItemsSource="{Binding}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Grid
						Margin="0,2">
						<FrameworkElement.ContextMenu>
							<ContextMenu>
								<MenuItem
									Header="{StaticResource FunctionList_Delete}"
									Command="l:FunctionListCommands.DeleteCommand"
									CommandParameter="{Binding}" />
								<MenuItem
									Header="{StaticResource FunctionList_Copy}"
									Command="l:FunctionListCommands.CopyCommand">
									<MenuItem.Icon>
										<Image
											Source="Images/copy_dark.png"
											Style="{StaticResource buttonImageStyle}" />
									</MenuItem.Icon>
								</MenuItem>
								<MenuItem
									Header="{StaticResource FunctionList_Insert}"
									Command="l:FunctionListCommands.InsertCommand"
									CommandParameter="{Binding Name}" />
							</ContextMenu>
						</FrameworkElement.ContextMenu>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="*" />
							<RowDefinition />
						</Grid.RowDefinitions>
						<ToggleButton
							Command=""
							IsChecked="{Binding IsFavorited, Mode=TwoWay}" />
						<TextBlock
							Grid.Column="1"
							Grid.Row="0"
							Text="{Binding FullName, Mode=OneWay}" />
						<TextBlock
							Grid.Column="1"
							Grid.Row="1"
							Foreground="#FF808080"
							Text="{Binding Content, Mode=OneWay}">
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type TextBlock}">
									<Style.Triggers>
										<DataTrigger
											Binding="{Binding Content}"
											Value="{x:Null}">
											<Setter
												Property="Visibility"
												Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</TextBlock>
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ListView>
	</Grid>
</UserControl>
