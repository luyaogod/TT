<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		x:Key="WindowStyle"
		TargetType="{x:Type Window}">
		<Setter
			Property="Window.ShowInTaskbar"
			Value="False" />
		<Setter
			Property="Window.ResizeMode"
			Value="NoResize" />
		<Setter
			Property="Window.WindowStyle"
			Value="ToolWindow" />
		<Setter
			Property="MaxWidth"
			Value="250" />
		<Setter
			Property="Width"
			Value="250" />
		<Setter
			Property="Window.SizeToContent"
			Value="Height" />
	</Style>
</ResourceDictionary>
