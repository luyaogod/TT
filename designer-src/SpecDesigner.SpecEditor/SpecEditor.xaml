<UserControl
	x:Class="SpecDesigner.SpecEditor.SpecEditor"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:SpecDesigner.SpecEditor"
	xmlns:helper="clr-namespace:SpecDesigner.SpecEditor.Helpers"
	x:Name="editor">
	<FrameworkElement.Resources>
		<helper:NullVisibilityConveter
			x:Key="NullVisibilityConveter" />
		<BooleanToVisibilityConverter
			x:Key="BoolToVisibility" />
		<helper:PreviewButtonEnabledMultiBindingConverter
			x:Key="PreviewButtonEnabledMultiBindingConverter" />
	</FrameworkElement.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<Border>
			<ScrollViewer
				x:Name="SpecButtonsSV"
				VerticalScrollBarVisibility="Auto"
				Margin="5">
				<StackPanel
					HorizontalAlignment="Center"
					VerticalAlignment="Top">
					<Button
						x:Name="allButton"
						Margin="5"
						Tag="{StaticResource specEditor_AllSpec}"
						Click="allButton_Click">
						<FrameworkElement.Style>
							<Style
								BasedOn="{StaticResource {x:Type Button}}"
								TargetType="{x:Type Button}">
								<Style.Triggers>
									<DataTrigger
										Value="ALL"
										Binding="{Binding SpecType, ElementName=editor}">
										<Setter
											Property="Foreground"
											Value="#FF0000FF" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
						<ContentControl.Content>
							<StackPanel
								Orientation="Horizontal">
								<TextBlock
									Text="{StaticResource specEditor_AllSpec}" />
								<Image
									Margin="5 2 0 0"
									Source="Images/application-link-icon.png">
									<FrameworkElement.Style>
										<Style
											TargetType="{x:Type Image}">
											<Style.Triggers>
												<DataTrigger
													Value="True"
													Binding="{Binding DataContext.IsCited, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=1}}">
													<Setter
														Property="Visibility"
														Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
											<Setter
												Property="Visibility"
												Value="Collapsed" />
										</Style>
									</FrameworkElement.Style>
								</Image>
							</StackPanel>
						</ContentControl.Content>
					</Button>
					<Button
						x:Name="miallButton"
						Margin="5"
						Tag="{StaticResource specEditor_MiAllSpec}"
						Click="miallButton_Click">
						<FrameworkElement.Style>
							<Style
								BasedOn="{StaticResource {x:Type Button}}"
								TargetType="{x:Type Button}">
								<Style.Triggers>
									<DataTrigger
										Value="MI"
										Binding="{Binding SpecType, ElementName=editor}">
										<Setter
											Property="Foreground"
											Value="#FF0000FF" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
						<ContentControl.Content>
							<StackPanel
								Orientation="Horizontal">
								<TextBlock
									Text="{StaticResource specEditor_MiAllSpec}" />
								<Image
									Margin="5 2 0 0"
									Source="Images/application-link-icon.png">
									<FrameworkElement.Style>
										<Style
											TargetType="{x:Type Image}">
											<Style.Triggers>
												<DataTrigger
													Value="True"
													Binding="{Binding DataContext.IsCited, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=1}}">
													<Setter
														Property="Visibility"
														Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
											<Setter
												Property="Visibility"
												Value="Collapsed" />
										</Style>
									</FrameworkElement.Style>
								</Image>
							</StackPanel>
						</ContentControl.Content>
					</Button>
					<Button
						x:Name="dballButton"
						Margin="5"
						Tag="{StaticResource specEditor_DbAllSpec}"
						Click="dballButton_Click">
						<FrameworkElement.Style>
							<Style
								BasedOn="{StaticResource {x:Type Button}}"
								TargetType="{x:Type Button}">
								<Style.Triggers>
									<DataTrigger
										Value="DB"
										Binding="{Binding SpecType, ElementName=editor}">
										<Setter
											Property="Foreground"
											Value="#FF0000FF" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
						<ContentControl.Content>
							<StackPanel
								Orientation="Horizontal">
								<TextBlock
									Text="{StaticResource specEditor_DbAllSpec}" />
								<Image
									Margin="5 2 0 0"
									Source="Images/application-link-icon.png">
									<FrameworkElement.Style>
										<Style
											TargetType="{x:Type Image}">
											<Style.Triggers>
												<DataTrigger
													Value="True"
													Binding="{Binding DataContext.IsCited, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=1}}">
													<Setter
														Property="Visibility"
														Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
											<Setter
												Property="Visibility"
												Value="Collapsed" />
										</Style>
									</FrameworkElement.Style>
								</Image>
							</StackPanel>
						</ContentControl.Content>
					</Button>
					<Button
						x:Name="diallButton"
						Margin="5"
						Tag="{StaticResource specEditor_DiAllSpec}"
						Click="diallButton_Click">
						<FrameworkElement.Style>
							<Style
								BasedOn="{StaticResource {x:Type Button}}"
								TargetType="{x:Type Button}">
								<Style.Triggers>
									<DataTrigger
										Value="DI"
										Binding="{Binding SpecType, ElementName=editor}">
										<Setter
											Property="Foreground"
											Value="#FF0000FF" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
						<ContentControl.Content>
							<StackPanel
								Orientation="Horizontal">
								<TextBlock
									Text="{StaticResource specEditor_DiAllSpec}" />
								<Image
									Margin="5 2 0 0"
									Source="Images/application-link-icon.png">
									<FrameworkElement.Style>
										<Style
											TargetType="{x:Type Image}">
											<Style.Triggers>
												<DataTrigger
													Value="True"
													Binding="{Binding DataContext.IsCited, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=1}}">
													<Setter
														Property="Visibility"
														Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
											<Setter
												Property="Visibility"
												Value="Collapsed" />
										</Style>
									</FrameworkElement.Style>
								</Image>
							</StackPanel>
						</ContentControl.Content>
					</Button>
				</StackPanel>
			</ScrollViewer>
		</Border>
		<GridSplitter
			Width="5"
			Margin="25,0,0,0" />
		<Grid
			x:Name="SpecEditorGrid"
			Column="1">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="25" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<CheckBox
				x:Name="saSpecViewCB"
				Visibility="Collapsed"
				Content="{StaticResource specEditor_saSpecViewCB}"
				VerticalAlignment="Center"
				HorizontalAlignment="Right"
				Click="saSpecViewCB_Click" />
			<StackPanel
				Orientation="Horizontal">
				<TextBlock
					Text="{StaticResource specEditor_SDSpec}"
					VerticalAlignment="Center" />
				<CheckBox
					x:Name="refSpecCheckBox"
					Content="{StaticResource specEditor_refStdSpec}"
					VerticalAlignment="Center"
					Margin="5 0 5 0"
					Visibility="Collapsed"
					Command="local:MenuCommands.SetCiteCommand"
					CommandParameter="{Binding DataContext, Mode=OneWay, RelativeSource={RelativeSource Self}}"
					IsChecked="{Binding IsCited, Mode=OneWay}" />
			</StackPanel>
			<Grid
				x:Name="specGrid"
				Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*"
						MinWidth="200" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>
				<ScrollViewer
					x:Name="customSpecScrollViewer"
					VerticalScrollBarVisibility="Auto"
					Grid.Column="0"
					HorizontalScrollBarVisibility="Auto">
					<TextBox
						x:Name="specTextBox"
						TextWrapping="Wrap"
						AcceptsReturn="True"
						VerticalContentAlignment="Top"
						Text="{Binding CDATA, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
						<FrameworkElement.Style>
							<Style
								BasedOn="{StaticResource {x:Type TextBox}}"
								TargetType="{x:Type TextBox}">
								<Style.Triggers>
									<MultiDataTrigger>
										<MultiDataTrigger.Conditions>
											<Condition
												Value="True"
												Binding="{Binding IsCited}" />
										</MultiDataTrigger.Conditions>
										<Setter
											Property="TextBoxBase.IsReadOnly"
											Value="True" />
										<Setter
											Property="Background"
											Value="#FFE2E2E2" />
									</MultiDataTrigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</TextBox>
				</ScrollViewer>
				<ScrollViewer
					x:Name="SASpecViewer"
					VerticalScrollBarVisibility="Auto"
					HorizontalScrollBarVisibility="Auto"
					Grid.Column="1"
					Visibility="Collapsed">
					<TextBox
						x:Name="SASpecTextBox"
						Foreground="#FF0000FF"
						IsReadOnly="True"
						TextWrapping="Wrap" />
				</ScrollViewer>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
