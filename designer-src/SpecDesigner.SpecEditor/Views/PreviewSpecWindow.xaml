<Window
	x:Class="SpecDesigner.SpecEditor.Views.PreviewSpecWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="PreviewSpecWidnow"
	Height="300"
	Width="300"
	xmlns:views="clr-namespace:SpecDesigner.SpecEditor.Views">
	<Grid>
		<RichTextBox
			IsReadOnly="True"
			ScrollViewer.HorizontalScrollBarVisibility="Auto"
			ScrollViewer.VerticalScrollBarVisibility="Auto">
			<FlowDocument>
				<Paragraph
					x:Name="standardSpec"
					Margin="0"
					Foreground="#FF0000FF" />
				<Paragraph
					x:Name="citeSpec"
					Margin="0" />
			</FlowDocument>
		</RichTextBox>
	</Grid>
</Window>
